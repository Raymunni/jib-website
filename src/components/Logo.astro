---
// Jib logo: the house-and-tick mark and "Jib" written in Caveat, the same pen
// as the "sorted." in the headline.
interface Props {
  size?: number;
  color?: string;
  wordmark?: boolean;
}
const { size = 34, color = '#ffffff', wordmark = true } = Astro.props;
const markW = Math.round(size * (546 / 512));
---

<span class="jib-logo" role="img" aria-label="Jib" style={`--logo-size:${size}px;color:${color}`}>
  <img src="/images/jib-mark.png" width={markW} height={size} alt="" />
  {wordmark && <span class="jib-wordmark" aria-hidden="true">Jib</span>}
</span>

<style>
  :global(a:has(.jib-logo)) {
    text-decoration: none;
  }
  .jib-logo {
    display: inline-flex;
    /* baseline: the image sits on the text baseline, so the bottom of
       "Jib" lines up exactly with the bottom of the house */
    align-items: baseline;
    gap: calc(var(--logo-size) * 0.26);
    text-decoration: none;
    line-height: 1;
  }
  .jib-logo img {
    display: block;
    height: var(--logo-size);
    width: auto;
  }
  .jib-wordmark {
    font-family: 'Caveat', cursive;
    font-weight: 500;
    font-size: calc(var(--logo-size) * 1.25);
    letter-spacing: -0.03em;
    text-decoration: none;
    /* The J's tail drops below the line; lift the word so "ib" sits level
       with the house */
    position: relative;
    top: -0.09em;
  }
</style>
