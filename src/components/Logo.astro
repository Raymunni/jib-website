---
// Jib logo: the house-and-tick mark with the Jib wordmark beside it.
interface Props {
  size?: number;
  color?: string;
  wordmark?: boolean;
}
const { size = 34, color = '#ffffff', wordmark = true } = Astro.props;
---

<span class="jib-logo" role="img" aria-label="Jib" style={`--logo-size:${size}px;color:${color}`}>
  <img src="/images/jib-mark.png" width={size} height={size} alt="" />
  {wordmark && <span class="jib-wordmark" aria-hidden="true">Jib</span>}
</span>

<style>
  .jib-logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.28);
    text-decoration: none;
  }
  .jib-logo img {
    display: block;
    width: var(--logo-size);
    height: var(--logo-size);
  }
  .jib-wordmark {
    font-weight: 800;
    font-size: calc(var(--logo-size) * 0.72);
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    display: inline-block;
  }
</style>
