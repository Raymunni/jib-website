---
// Jib logo: the house-and-tick mark and "Jib" set in Nunito (weight 550),
// whose rounded ends match the icon's soft strokes.
interface Props {
  size?: number;
  color?: string;
  wordmark?: boolean;
}
const { size = 34, color = '#ffffff', wordmark = true } = Astro.props;
const markW = Math.round(size * (546 / 512));
---

<span class="jib-logo" role="img" aria-label="Jib" style={`--logo-size:${size}px;color:${color}`}>
  <img src="/images/jib-mark.png" width={markW} height={size} alt="" />
  {wordmark && <span class="jib-wordmark" aria-hidden="true">Jib</span>}
</span>

<style>
  :global(a:has(.jib-logo)) {
    text-decoration: none;
  }
  .jib-logo {
    display: inline-flex;
    /* baseline: the image sits on the text baseline, so the bottom of
       "Jib" lines up exactly with the bottom of the house */
    align-items: baseline;
    gap: calc(var(--logo-size) * 0.26);
    text-decoration: none;
    line-height: 1;
  }
  .jib-logo img {
    display: block;
    height: var(--logo-size);
    width: auto;
  }
  .jib-wordmark {
    font-family: 'Nunito', ui-rounded, system-ui, sans-serif;
    font-weight: 550;
    font-size: calc(var(--logo-size) * 1.03);
    letter-spacing: -0.01em;
    text-decoration: none;
    /* Nunito's letters sit 0.011em below the baseline; lift them so the
       bottom of "Jib" meets the bottom of the house exactly */
    position: relative;
    top: -0.011em;
  }
</style>
