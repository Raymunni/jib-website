---
// Illustrated icon tile for each free tool, so the tool cards are
// recognisable at a glance. Pure SVG (no image requests), 64×64 artwork on
// a coloured gradient tile.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 72 } = Astro.props;

const palette: Record<string, [string, string]> = {
  checker: ['#2e9d57', '#1d6b3b'],
  bathroom: ['#2f8fd8', '#1f5f9e'],
  units: ['#7c5cff', '#4b36b8'],
  paint: ['#e8588f', '#a93768'],
  concrete: ['#8a96a8', '#566173'],
  soil: ['#b07a3c', '#7a4f22'],
  fence: ['#c9933f', '#8e6424'],
  walltile: ['#26a6a6', '#16706f'],
  plaster: ['#9aa7bd', '#5d6b84'],
  decking: ['#b8793d', '#7d4d21'],
  stairs: ['#f08a3c', '#b35a17'],
  roof: ['#d9534f', '#98312e'],
  planner: ['#3f7fe0', '#2a54a0'],
  // Feature icons (home page)
  snap: ['#3f7fe0', '#2a4fa0'],
  steps: ['#7c5cff', '#4b36b8'],
  cart: ['#f08a3c', '#b35a17'],
  toolbox: ['#d9534f', '#98312e'],
  clock: ['#26a6a6', '#16706f'],
  cost: ['#2e9d57', '#1d6b3b'],
  bell: ['#e8a33c', '#a86d17'],
  rooms: ['#5b8def', '#3558a8'],
  beforeafter: ['#e8588f', '#a93768'],
  chat: ['#9b5cf0', '#6534b0'],
  homes: ['#b8793d', '#7d4d21'],
  web: ['#4f6d8f', '#2f4560'],
  climate: ['#e0b83f', '#a07c1c'],
};
const [c1, c2] = palette[name] ?? ['#2770da', '#1a4a90'];
const id = `ti-${name}`;
---

<span class="tool-icon" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 64 64" width={size} height={size}>
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={c1} />
        <stop offset="1" stop-color={c2} />
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="16" fill={`url(#${id})`} />
    <g fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      {
        name === 'checker' && (
          <>
            <path d="M32 12 47 18v11c0 10-6.5 17.5-15 21-8.5-3.5-15-11-15-21V18z" fill="rgba(255,255,255,.15)" />
            <path d="m25 31 5 5 10-11" />
          </>
        )
      }
      {
        name === 'bathroom' && (
          <>
            <path d="M12 30h40v6a10 10 0 0 1-10 10H22a10 10 0 0 1-10-10z" fill="rgba(255,255,255,.15)" />
            <path d="M18 30V18a5 5 0 0 1 10 0" />
            <path d="M20 46l-2 5M44 46l2 5" />
            <path d="M14 56h36M20 56v-2M30 56v-2M40 56v-2" stroke-width="2" />
          </>
        )
      }
      {
        name === 'units' && (
          <>
            <rect x="9" y="24" width="46" height="16" rx="3" fill="rgba(255,255,255,.15)" />
            <path d="M16 24v7M23 24v4M30 24v7M37 24v4M44 24v7M51 24v4" />
            <path d="M22 50h20M22 50l4-4M22 50l4 4M42 50l-4-4M42 50l-4 4" stroke-width="2.2" />
          </>
        )
      }
      {
        name === 'paint' && (
          <>
            <rect x="12" y="12" width="32" height="12" rx="3" fill="rgba(255,255,255,.2)" />
            <path d="M44 18h6v10H31v8" />
            <rect x="27" y="36" width="8" height="16" rx="2" fill="rgba(255,255,255,.2)" />
          </>
        )
      }
      {
        name === 'concrete' && (
          <>
            <path d="M18 16h28l3 34a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3z" fill="rgba(255,255,255,.15)" />
            <path d="M18 16c4 3 24 3 28 0" />
            <path d="M22 34h20M24 41h16" stroke-width="2.2" />
            <text x="32" y="30" fill="#fff" stroke="none" font-size="9" font-weight="800" text-anchor="middle" font-family="Arial, sans-serif">20kg</text>
          </>
        )
      }
      {
        name === 'soil' && (
          <>
            <path d="M10 30h30l-5 12H17z" fill="rgba(255,255,255,.15)" />
            <path d="M14 30c4-8 18-10 24 0" fill="rgba(255,255,255,.25)" />
            <path d="M40 30l12-8M26 42v4" />
            <circle cx="26" cy="49" r="4" />
          </>
        )
      }
      {
        name === 'fence' && (
          <>
            <path d="M14 52V20l4-5 4 5v32M28 52V20l4-5 4 5v32M42 52V20l4-5 4 5v32" fill="rgba(255,255,255,.15)" />
            <path d="M10 28h44M10 42h44" />
          </>
        )
      }
      {
        name === 'walltile' && (
          <>
            <rect x="12" y="12" width="40" height="40" rx="3" fill="rgba(255,255,255,.12)" />
            <path d="M12 25h40M12 38h40M25 12v13M39 12v13M18 25v13M32 25v13M46 25v13M25 38v14M39 38v14" stroke-width="2.2" />
          </>
        )
      }
      {
        name === 'plaster' && (
          <>
            <path d="M16 14h26l6 6v30H16z" fill="rgba(255,255,255,.18)" />
            <path d="M42 14v6h6" />
            <path d="M22 44l20-20" stroke-width="2" />
            <circle cx="21" cy="20" r="1.4" fill="#fff" />
            <circle cx="21" cy="44" r="1.4" fill="#fff" />
            <circle cx="43" cy="44" r="1.4" fill="#fff" />
          </>
        )
      }
      {
        name === 'decking' && (
          <>
            <path d="M10 22h44M10 30h44M10 38h44M10 46h44" stroke-width="5" stroke="rgba(255,255,255,.35)" />
            <path d="M10 22h44M10 30h44M10 38h44M10 46h44" stroke-width="1.6" />
            <circle cx="20" cy="22" r="1.2" fill="#fff" />
            <circle cx="44" cy="30" r="1.2" fill="#fff" />
            <circle cx="20" cy="38" r="1.2" fill="#fff" />
            <circle cx="44" cy="46" r="1.2" fill="#fff" />
          </>
        )
      }
      {
        name === 'stairs' && (
          <>
            <path d="M10 52h11V42h11V32h11V22h11v30z" fill="rgba(255,255,255,.18)" />
            <path d="M10 52h11V42h11V32h11V22h11" />
            <path d="M14 34l20-18" stroke-width="2" stroke-dasharray="3 3" />
          </>
        )
      }
      {
        name === 'roof' && (
          <>
            <path d="M8 38 32 16l24 22" />
            <path d="M16 31v19h32V31" fill="rgba(255,255,255,.15)" />
            <path d="M32 16v22M32 38h14" stroke-width="2" stroke-dasharray="3 3" />
            <path d="M40 38a8 8 0 0 0-2-6" stroke-width="2" />
          </>
        )
      }
      {
        name === 'snap' && (
          <>
            <path d="M12 22a4 4 0 0 1 4-4h6l3-5h14l3 5h6a4 4 0 0 1 4 4v22a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4z" fill="rgba(255,255,255,.15)" />
            <circle cx="32" cy="32" r="8" />
            <path d="M49 10l1.5 3.5L54 15l-3.5 1.5L49 20l-1.5-3.5L44 15l3.5-1.5z" fill="#fff" stroke="none" />
          </>
        )
      }
      {
        name === 'steps' && (
          <>
            <rect x="12" y="10" width="40" height="44" rx="5" fill="rgba(255,255,255,.12)" />
            <text x="20" y="25" fill="#fff" stroke="none" font-size="9" font-weight="800" font-family="Arial, sans-serif">1</text>
            <text x="20" y="37" fill="#fff" stroke="none" font-size="9" font-weight="800" font-family="Arial, sans-serif">2</text>
            <text x="20" y="49" fill="#fff" stroke="none" font-size="9" font-weight="800" font-family="Arial, sans-serif">3</text>
            <path d="M28 22h16M28 34h16M28 46h11" />
          </>
        )
      }
      {
        name === 'cart' && (
          <>
            <path d="M10 14h7l6 26h24l5-18H20" fill="rgba(255,255,255,.12)" />
            <circle cx="26" cy="48" r="3.5" />
            <circle cx="43" cy="48" r="3.5" />
            <path d="m27 30 4 4 8-8" stroke-width="2.2" />
          </>
        )
      }
      {
        name === 'toolbox' && (
          <>
            <rect x="10" y="24" width="44" height="26" rx="4" fill="rgba(255,255,255,.15)" />
            <path d="M24 24v-5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v5M10 35h44M28 35v5h8v-5" />
          </>
        )
      }
      {
        name === 'clock' && (
          <>
            <circle cx="32" cy="33" r="19" fill="rgba(255,255,255,.15)" />
            <path d="M32 22v11l8 5M26 10h12" />
          </>
        )
      }
      {
        name === 'cost' && (
          <>
            <rect x="10" y="18" width="44" height="28" rx="5" fill="rgba(255,255,255,.15)" />
            <text x="32" y="38" fill="#fff" stroke="none" font-size="17" font-weight="800" text-anchor="middle" font-family="Arial, sans-serif">$</text>
            <path d="M16 24h4M44 40h4" />
          </>
        )
      }
      {
        name === 'bell' && (
          <>
            <path d="M20 42V30a12 12 0 0 1 24 0v12l4 4H16z" fill="rgba(255,255,255,.15)" />
            <path d="M28 50a4 4 0 0 0 8 0M32 14v4" />
            <path d="M50 18a8 8 0 0 1 0 10" stroke-width="2" />
          </>
        )
      }
      {
        name === 'rooms' && (
          <>
            <path d="M10 30 32 12l22 18v22H10z" fill="rgba(255,255,255,.12)" />
            <path d="M10 30 32 12l22 18M32 30v22M10 41h44" stroke-width="2.2" />
          </>
        )
      }
      {
        name === 'beforeafter' && (
          <>
            <rect x="10" y="14" width="44" height="36" rx="5" fill="rgba(255,255,255,.15)" />
            <path d="M32 10v44" />
            <path d="M16 42l7-9 5 6M38 42l5-7 6 7" stroke-width="2.2" />
            <circle cx="32" cy="32" r="4" fill="#fff" />
          </>
        )
      }
      {
        name === 'chat' && (
          <>
            <path d="M12 16h40v24H28l-10 8v-8h-6z" fill="rgba(255,255,255,.15)" />
            <path d="M32 21l1.8 4.2L38 27l-4.2 1.8L32 33l-1.8-4.2L26 27l4.2-1.8z" fill="#fff" stroke="none" />
          </>
        )
      }
      {
        name === 'homes' && (
          <>
            <path d="M8 34 20 24l12 10v16H8z" fill="rgba(255,255,255,.12)" />
            <path d="M28 30 42 18l14 12v20H28z" fill="rgba(255,255,255,.2)" />
            <path d="M38 50v-8h8v8" stroke-width="2.2" />
          </>
        )
      }
      {
        name === 'web' && (
          <>
            <rect x="12" y="14" width="40" height="26" rx="3" fill="rgba(255,255,255,.15)" />
            <path d="M8 46h48" />
            <path d="M18 22h10M18 28h16M18 34h8" stroke-width="2" />
          </>
        )
      }
      {
        name === 'climate' && (
          <>
            <circle cx="24" cy="24" r="7" fill="rgba(255,255,255,.2)" />
            <path d="M24 10v3M24 35v3M10 24h3M35 24h3M14 14l2 2M32 32l2 2M14 34l2-2M32 16l2-2" stroke-width="2" />
            <path d="M28 46a8 8 0 0 1 2-15 10 10 0 0 1 19 4 6 6 0 0 1-1 11z" fill="rgba(255,255,255,.3)" />
          </>
        )
      }
      {
        name === 'planner' && (
          <>
            <rect x="12" y="16" width="40" height="36" rx="4" fill="rgba(255,255,255,.15)" />
            <path d="M12 26h40M22 12v8M42 12v8" />
            <path d="m24 39 5 5 11-11" />
          </>
        )
      }
    </g>
  </svg>
</span>

<style>
  .tool-icon {
    display: inline-block;
    flex: none;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }
  .tool-icon svg {
    display: block;
  }
</style>
