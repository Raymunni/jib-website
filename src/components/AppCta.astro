---
// Class names use a neutral "jp" prefix: ad blockers hide anything named
// like ".ad-*", which would remove these for many visitors.
// An ad for the Jib app inside a guide. Every placement is its own ad:
// its own photo of that exact situation (Nano Banana, public/images/jib/),
// its own pitch, and a real screenshot of that job in the Jib app
// (public/images/jib/shots/) on a phone over the photo. Labelled "Ad".
// Without a photo it still renders, as a text-only card.
import type { Campaign } from '../config';
import { STORES, anyStoreLive } from '../config';

interface Props {
  // "extra" marks a guide's second mid-article ad (see scripts/apply-ads.mjs).
  place?: string;
  text: string;
  headline?: string;
  image?: string;
  imageAlt?: string;
  // A real screenshot of the job in Jib, shown on the phone.
  shot?: string;
  campaign?: Campaign;
  variant?: 'inline' | 'end';
}

const { text, headline, image, imageAlt = '', shot, campaign = 'general', variant = 'inline' } = Astro.props;

const href = `/app/?c=${campaign}&p=${variant}`;
const where = STORES.ios.live && STORES.android.live ? 'iPhone and Android' : STORES.android.live ? 'Android now, iPhone soon' : 'Launching soon';
---

<aside class={`jp jp-${variant}${image ? '' : ' jp-plain'}${shot ? ' jp-shot' : ''}`} aria-label="From Jib">
  {
    image && (
      <a class="jp-media" href={href} data-get-app tabindex="-1" aria-hidden="true">
        <img class="jp-photo" src={image} alt={imageAlt} loading="lazy" decoding="async" width="1376" height="768" />
        {shot && (
          <span class="phone">
            <img src={shot} alt="" loading="lazy" decoding="async" />
          </span>
        )}
      </a>
    )
  }
  <div class="jp-body">
    {/* Room for the bottom of the phone, which hangs over from the photo
        (mid-article only): the words wrap around it, then run full width. */}
    {image && shot && variant === 'inline' && <span class="jp-dodge" aria-hidden="true" />}
    <div class="jp-brand">
      <span class="jp-name">Jib</span>
      <span class="jp-tag">Home jobs, planned by AI</span>
      <span class="jp-label">Ad</span>
    </div>
    {headline && <p class="jp-headline">{headline}</p>}
    <p class="jp-text">{text}</p>
    {/* Like an app store listing: icon, name, what it does, and GET. */}
    <a class="jp-btn" href={href} data-get-app>
      <img class="jp-btn-icon" src="/icon-192.png" alt="" width="52" height="52" />
      <span class="jp-btn-copy">
        <span class="jp-btn-main">{anyStoreLive ? 'Get Jib free' : 'Get Jib'}</span>
        <span class="jp-btn-sub">{where}<span class="jp-btn-more"> · Plans any job from a photo</span></span>
      </span>
      <span class="jp-btn-get">
        {anyStoreLive ? 'Get' : 'Soon'}
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M13.2 5.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 1 1-1.4-1.4l4.3-4.3H4a1 1 0 1 1 0-2h13.5l-4.3-4.3a1 1 0 0 1 0-1.4Z" /></svg>
      </span>
    </a>
  </div>
</aside>

<style>
  .jp {
    --jp-ring: linear-gradient(120deg, #2770da, #7c3aed 45%, #e85d9e 75%, #2c5ca2);
    position: relative;
    margin: 2.4em 0;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(160deg, #18304d 0%, #111d2c 70%);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
    container-type: inline-size;
  }
  /* The AI colours as a thin ring, like the app's AI buttons. */
  .jp::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.5px;
    background: var(--jp-ring);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.8;
    pointer-events: none;
  }
  .jp-end {
    margin-top: 3em;
  }

  /* The photo, with the real app on a phone over it. */
  .jp-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    background: #0e1824;
    overflow: hidden;
  }
  .jp-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .jp-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 29, 44, 0) 60%, rgba(17, 29, 44, 0.55) 100%);
    pointer-events: none;
  }
  .phone {
    position: absolute;
    z-index: 1;
    right: 5%;
    top: 7%;
    width: 23%;
    max-width: 190px;
    /* The screen's corners run exactly parallel to the body's: inner
       radius = outer radius - bezel. Kept upright so edges and the app's
       text stay pixel-sharp. */
    --bezel: 6px;
    --r: 26px;
    border-radius: var(--r);
    padding: var(--bezel);
    background: linear-gradient(145deg, #2a2f36, #0a0c10 40%, #050608);
    box-shadow:
      0 26px 46px -14px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(255, 255, 255, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .phone img {
    display: block;
    width: 100%;
    /* The whole screen, as on the phone (1080 x 2400). */
    aspect-ratio: 9 / 20;
    object-fit: cover;
    border-radius: calc(var(--r) - var(--bezel));
    background: #0e1824;
  }

  /* Words and the button. */
  .jp-body {
    position: relative;
    padding: 18px 22px 22px;
  }
  .jp-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 0.82rem;
  }
  .jp-name {
    font-family: 'Nunito', var(--font);
    font-weight: 550;
    font-size: 1.05rem;
    color: #fff;
  }
  .jp-tag {
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .jp-label {
    margin-left: auto;
    flex: none;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .jp-headline {
    margin: 0 0 6px;
    font-size: 1.32rem;
    font-weight: 800;
    line-height: 1.25;
    color: #fff;
    text-wrap: pretty;
  }
  .jp-text {
    margin: 0 0 16px;
    color: var(--text);
    line-height: 1.5;
  }

  /* A full-width bar like an app store listing (icon, name, GET), in
     frosted glass over the moving AI gradient, like the app's AI buttons. */
  .jp-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 12px 12px 12px 12px;
    border-radius: 18px;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 26px -8px rgba(124, 58, 237, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .jp-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--jp-ring);
    background-size: 220% 220%;
    opacity: 0.55;
    animation: jp-sweep 6s ease-in-out infinite alternate;
  }
  .jp-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px -8px rgba(232, 93, 158, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .jp-btn-icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.22);
  }
  .jp-btn-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .jp-btn-main {
    font-family: 'Nunito', var(--font);
    font-weight: 900;
    font-size: 1.12rem;
    line-height: 1.2;
  }
  .jp-btn-sub {
    font-size: 0.8rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
  }
  .jp-btn-get {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px 9px 18px;
    border-radius: 999px;
    background: #fff;
    color: #1d4fb5;
    font-weight: 900;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px -4px rgba(0, 0, 0, 0.5);
    transition: transform 0.15s ease;
  }
  .jp-btn:hover .jp-btn-get {
    transform: translateX(2px);
  }
  /* Narrow cards (phones): a smaller icon and just the platforms. */
  @container (max-width: 460px) {
    .jp-btn {
      gap: 12px;
      padding: 10px;
    }
    .jp-btn-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }
    .jp-btn-more {
      display: none;
    }
  }
  @keyframes jp-sweep {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jp-btn::before {
      animation: none;
    }
  }

  /* Mid-article: a shorter photo, the phone hanging over into the words. */
  .jp-inline .jp-media {
    aspect-ratio: 2.2 / 1;
    overflow: visible;
  }
  .jp-inline .jp-photo {
    border-radius: 0;
  }
  .jp-inline .phone {
    top: 8%;
    width: 22%;
  }
  /* The phone is 22% of the card wide (at most 190px), 8% down a 2.2:1
     photo, screen 9:20 inside a 6px bezel. The dodge is just the part of
     it that hangs below the photo, plus a little air. */
  .jp-dodge {
    display: none;
  }
  .jp-inline .jp-dodge {
    display: block;
    float: right;
    width: calc(5cqw + min(22cqw, 190px) - 8px);
    height: max(0px, calc(3.64cqw + min(22cqw, 190px) * 2.2222 - 14.7px - 45.45cqw - 6px));
  }
  .jp-inline .jp-media::after {
    background: linear-gradient(180deg, rgba(17, 29, 44, 0) 70%, rgba(17, 29, 44, 0.6) 100%);
  }
  @media (max-width: 719px) {
    .jp-inline .jp-media {
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }
    .jp-inline .jp-photo {
      object-position: left center;
    }
    .jp-inline .jp-dodge {
      display: none;
    }
    .jp-inline .phone,
    .phone {
      top: 6%;
      width: 25%;
      --bezel: 4px;
      --r: 18px;
    }
    .jp-headline {
      font-size: 1.15rem;
    }
  }
</style>
