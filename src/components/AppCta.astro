---
// An ad for the Jib app inside a guide. Every placement is its own ad:
// its own photo of that exact situation (Nano Banana, public/images/ads/),
// its own pitch, and a real screenshot of that job in the Jib app
// (public/images/ads/shots/) on a phone over the photo. Labelled "Ad".
// Without a photo it still renders, as a text-only card.
import type { Campaign } from '../config';
import { STORES, anyStoreLive } from '../config';

interface Props {
  text: string;
  headline?: string;
  image?: string;
  imageAlt?: string;
  // A real screenshot of the job in Jib, shown on the phone.
  shot?: string;
  campaign?: Campaign;
  variant?: 'inline' | 'end';
}

const { text, headline, image, imageAlt = '', shot, campaign = 'general', variant = 'inline' } = Astro.props;

const href = `/app/?c=${campaign}&p=${variant}`;
const where = STORES.ios.live && STORES.android.live ? 'iPhone and Android' : STORES.android.live ? 'Android now, iPhone soon' : 'Launching soon';
---

<aside class={`ad ad-${variant}${image ? '' : ' ad-plain'}${shot ? ' ad-shot' : ''}`} aria-label="Ad for the Jib app">
  {
    image && (
      <a class="ad-media" href={href} data-get-app tabindex="-1" aria-hidden="true">
        <img class="ad-photo" src={image} alt={imageAlt} loading="lazy" decoding="async" width="1376" height="768" />
        {shot && (
          <span class="phone">
            <img src={shot} alt="" loading="lazy" decoding="async" />
          </span>
        )}
      </a>
    )
  }
  <div class="ad-body">
    <div class="ad-brand">
      <img src="/icon-192.png" alt="" width="28" height="28" />
      <span class="ad-name">Jib</span>
      <span class="ad-tag">Home jobs, planned by AI</span>
      <span class="ad-label">Ad</span>
    </div>
    {headline && <p class="ad-headline">{headline}</p>}
    <p class="ad-text">{text}</p>
    <a class="ad-btn" href={href} data-get-app>
      <span class="ad-btn-main">{anyStoreLive ? 'Get Jib free' : 'Get Jib'}</span>
      <span class="ad-btn-sub">{where}</span>
      <svg class="ad-btn-arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.2 5.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 1 1-1.4-1.4l4.3-4.3H4a1 1 0 1 1 0-2h13.5l-4.3-4.3a1 1 0 0 1 0-1.4Z" /></svg>
    </a>
  </div>
</aside>

<style>
  .ad {
    --ad-ring: linear-gradient(120deg, #2770da, #7c3aed 45%, #e85d9e 75%, #2c5ca2);
    position: relative;
    margin: 2.4em 0;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(160deg, #18304d 0%, #111d2c 70%);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
  }
  /* The AI colours as a thin ring, like the app's AI buttons. */
  .ad::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1.5px;
    background: var(--ad-ring);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.8;
    pointer-events: none;
  }
  .ad-end {
    margin-top: 3em;
  }

  /* The photo, with the real app on a phone over it. */
  .ad-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    background: #0e1824;
    overflow: hidden;
  }
  .ad-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ad-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 29, 44, 0) 60%, rgba(17, 29, 44, 0.55) 100%);
    pointer-events: none;
  }
  .phone {
    position: absolute;
    z-index: 1;
    right: 5%;
    top: 7%;
    width: 23%;
    max-width: 190px;
    /* The screen's corners run exactly parallel to the body's: inner
       radius = outer radius - bezel. Kept upright so edges and the app's
       text stay pixel-sharp. */
    --bezel: 6px;
    --r: 26px;
    border-radius: var(--r);
    padding: var(--bezel);
    background: linear-gradient(145deg, #2a2f36, #0a0c10 40%, #050608);
    box-shadow:
      0 26px 46px -14px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(255, 255, 255, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .phone img {
    display: block;
    width: 100%;
    /* The whole screen, exactly as rendered (status bar to navigation). */
    aspect-ratio: 1019 / 2151;
    object-fit: cover;
    border-radius: calc(var(--r) - var(--bezel));
    background: #0e1824;
  }

  /* Words and the button. */
  .ad-body {
    position: relative;
    padding: 18px 22px 22px;
  }
  .ad-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 0.82rem;
  }
  .ad-brand img {
    border-radius: 7px;
  }
  .ad-name {
    font-family: 'Nunito', var(--font);
    font-weight: 550;
    font-size: 1.05rem;
    color: #fff;
  }
  .ad-tag {
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .ad-label {
    margin-left: auto;
    flex: none;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .ad-headline {
    margin: 0 0 6px;
    font-size: 1.32rem;
    font-weight: 800;
    line-height: 1.25;
    color: #fff;
    text-wrap: balance;
  }
  .ad-text {
    margin: 0 0 16px;
    color: var(--text);
    line-height: 1.5;
  }

  /* Frosted glass over the moving AI gradient, like the app's AI buttons. */
  .ad-btn {
    position: relative;
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 14px;
    padding: 10px 16px 10px 20px;
    border-radius: 14px;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 26px -8px rgba(124, 58, 237, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ad-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ad-ring);
    background-size: 220% 220%;
    opacity: 0.55;
    animation: ad-sweep 6s ease-in-out infinite alternate;
  }
  .ad-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px -8px rgba(232, 93, 158, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .ad-btn-main {
    grid-column: 1;
    font-weight: 800;
    font-size: 1.02rem;
    line-height: 1.2;
  }
  .ad-btn-sub {
    grid-column: 1;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.8);
  }
  .ad-btn-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  @keyframes ad-sweep {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ad-btn::before {
      animation: none;
    }
  }

  /* Mid-article: a shorter photo, the phone hanging over into the words. */
  .ad-inline .ad-media {
    aspect-ratio: 2.2 / 1;
    overflow: visible;
  }
  .ad-inline .ad-photo {
    border-radius: 0;
  }
  .ad-inline .phone {
    top: 8%;
    width: 22%;
  }
  .ad-inline.ad-shot .ad-body {
    padding-right: calc(5% + min(22%, 190px) + 14px);
  }
  .ad-inline .ad-media::after {
    background: linear-gradient(180deg, rgba(17, 29, 44, 0) 70%, rgba(17, 29, 44, 0.6) 100%);
  }
  @media (max-width: 719px) {
    .ad-inline .ad-media {
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }
    .ad-inline .ad-photo {
      object-position: left center;
    }
    .ad-inline.ad-shot .ad-body {
      padding-right: 18px;
    }
    .ad-inline .phone,
    .phone {
      top: 6%;
      width: 25%;
      --bezel: 4px;
      --r: 18px;
    }
    .ad-headline {
      font-size: 1.15rem;
    }
  }
</style>
