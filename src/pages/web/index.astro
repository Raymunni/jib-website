---
// Jib on the web: sign in and manage the same homes, jobs, tools,
// shopping list and Toolbox as the phone app. Reads and writes the same
// users/{uid} document the app syncs, so edits show up on the phone.
import '../../styles/global.css';
import Logo from '../../components/Logo.astro';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jib on the web</title>
    <meta name="description" content="Sign in to manage your Jib jobs, tools, shopping list and Toolbox from your computer." />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://jibapp.xyz/web/" />
    <meta name="theme-color" content="#0e1824" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="webapp">
    <header class="w-top">
      <a class="w-brand" href="/web/" aria-label="Jib on the web"><Logo size={34} color="#ffffff" /><span>web</span></a>
      <div id="w-top-slot" class="w-top-slot"></div>
    </header>
    <main id="app" class="w-main" aria-live="polite">
      <div class="w-loading"><span class="spinner" aria-hidden="true"></span> Loading…</div>
    </main>
    <div id="w-toast" class="w-toast" role="status" aria-live="polite"></div>
    <script>
      import '../../web/app.ts';
    </script>
  </body>
</html>

<style is:global>
  body.webapp {
    min-height: 100vh;
    background: var(--bg);
  }
  .w-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    background: rgba(14, 24, 36, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .w-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
  }
  .w-brand span {
    font-size: 0.8rem;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .w-top-slot {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .w-main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }
  .w-loading {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 80px 0;
    color: var(--dim);
  }
  .spinner {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--border);
    border-top-color: var(--accent-2);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Tabs */
  .w-tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .w-tabs button {
    background: none;
    border: 0;
    color: var(--dim);
    font: inherit;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
  }
  .w-tabs button[aria-current='page'] {
    background: var(--surface-2);
    color: #fff;
  }
  .w-spacer {
    flex: 1;
  }
  .w-select,
  .w-input,
  .w-textarea {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    min-width: 0;
  }
  .w-input:focus,
  .w-textarea:focus,
  .w-select:focus {
    outline: 2px solid var(--accent-2);
    outline-offset: 1px;
  }
  .w-textarea {
    width: 100%;
    min-height: 90px;
    resize: vertical;
  }
  .w-btn {
    font: inherit;
    font-weight: 700;
    border-radius: 999px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .w-btn:hover {
    border-color: var(--accent-2);
  }
  .w-btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .w-btn.danger {
    color: var(--danger);
  }
  .w-btn.small {
    padding: 5px 11px;
    font-size: 0.85rem;
  }
  .w-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--accent-2);
    cursor: pointer;
  }
  .icon-btn {
    background: none;
    border: 0;
    color: var(--dim);
    cursor: pointer;
    font-size: 1.05rem;
    padding: 4px 6px;
    border-radius: 8px;
  }
  .icon-btn:hover {
    color: #fff;
    background: var(--surface-2);
  }

  /* Sign in */
  .w-auth {
    max-width: 420px;
    margin: 40px auto;
  }
  .w-auth h1 {
    font-size: 1.9rem;
  }
  .w-auth form {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }
  .w-or {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--dim);
    font-size: 0.85rem;
    margin: 18px 0 6px;
  }
  .w-or::before,
  .w-or::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--border);
  }
  .w-google {
    width: 100%;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: #1f1f1f;
    border-color: #fff;
  }
  .w-err {
    color: var(--danger);
    font-size: 0.92rem;
    margin: 4px 0 0;
  }
  .w-note {
    font-size: 0.9rem;
    color: var(--dim);
  }

  /* Toolbar and lists */
  .w-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 18px;
  }
  .w-bar h1 {
    font-size: 1.6rem;
    margin: 0 12px 0 0;
  }
  .chip {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    background: none;
    color: var(--dim);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: var(--accent-deep);
    border-color: var(--accent-2);
    color: #fff;
  }
  .w-group {
    margin-top: 26px;
  }
  .w-group > h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
    margin: 0 0 10px;
  }
  .w-jobs {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  }
  .job-card {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: center;
    text-align: left;
    width: 100%;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px;
    cursor: pointer;
    overflow: hidden;
  }
  .job-card:hover {
    border-color: var(--accent-2);
  }
  .job-card.done .jc-title {
    text-decoration: line-through;
    color: var(--dim);
  }
  .jc-thumb {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 12px;
    object-fit: cover;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    color: var(--dim);
    font-size: 1.4rem;
  }
  .jc-body {
    min-width: 0;
    flex: 1;
  }
  .jc-title {
    font-weight: 800;
    color: var(--ink);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .jc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 5px;
    font-size: 0.8rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid var(--border);
    color: var(--dim);
  }
  .pill.ok {
    color: #7ee2a2;
    border-color: rgba(63, 185, 107, 0.5);
    background: rgba(63, 185, 107, 0.1);
  }
  .pill.bad {
    color: #ff9c96;
    border-color: rgba(255, 90, 82, 0.5);
    background: rgba(255, 90, 82, 0.1);
  }
  .pill.warn {
    color: #ffd27a;
    border-color: rgba(242, 179, 61, 0.5);
    background: rgba(242, 179, 61, 0.1);
  }
  .pill.blue {
    color: #a9c8ff;
    border-color: rgba(79, 143, 240, 0.5);
    background: rgba(79, 143, 240, 0.12);
  }
  .w-empty {
    text-align: center;
    color: var(--dim);
    padding: 48px 16px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  /* Drawer */
  .w-scrim {
    position: fixed;
    inset: 0;
    background: rgba(5, 10, 16, 0.6);
    z-index: 40;
  }
  .w-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(620px, 100%);
    background: var(--bg-2);
    border-left: 1px solid var(--border);
    z-index: 41;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.4);
  }
  .w-drawer-inner {
    padding: 18px 20px 60px;
  }
  .w-drawer-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 96px;
    margin-bottom: 10px;
  }
  .w-hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .w-photos {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-top: 8px;
  }
  .w-photos img {
    width: 84px;
    height: 84px;
    object-fit: cover;
    border-radius: 10px;
    cursor: zoom-in;
    flex: none;
  }
  .w-title-input {
    width: 100%;
    font-size: 1.5rem;
    font-weight: 800;
    background: none;
    border: 1px solid transparent;
    padding: 4px 6px;
    margin: 12px 0 4px -6px;
  }
  .w-title-input:hover {
    border-color: var(--border);
  }
  .w-section {
    margin-top: 24px;
  }
  .w-section h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }
  .seg button {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--dim);
    padding: 6px 12px;
    cursor: pointer;
  }
  .seg button[aria-pressed='true'] {
    background: var(--accent);
    color: #fff;
  }
  .w-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .w-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .w-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 10px;
  }
  .w-item .grow {
    flex: 1;
    min-width: 0;
  }
  .w-item .sub {
    display: block;
    font-size: 0.8rem;
    color: var(--dim);
  }
  .w-item.bought .name {
    text-decoration: line-through;
    color: var(--dim);
  }
  .check {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 7px;
    border: 2px solid var(--dim);
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 0.8rem;
    padding: 0;
  }
  .check.on {
    background: var(--ok);
    border-color: var(--ok);
  }
  .w-add {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .w-add .w-input {
    flex: 1;
  }
  .w-steps {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: 8px;
  }
  .w-warn {
    background: rgba(242, 179, 61, 0.08);
    border: 1px solid rgba(242, 179, 61, 0.35);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .w-warn ul {
    margin: 0;
    padding-left: 1.2em;
  }
  .w-cost {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .w-stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 14px;
  }
  .w-stat strong {
    display: block;
    color: var(--ink);
    font-size: 1.1rem;
  }
  .w-stat span {
    font-size: 0.8rem;
    color: var(--dim);
  }

  /* Corner verdict sash, same shape as the app's */
  .sash {
    position: absolute;
    top: 0;
    right: 0;
    width: 132px;
    height: 132px;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  .sash span {
    position: absolute;
    top: 30px;
    right: -44px;
    width: 190px;
    transform: rotate(45deg);
    text-align: center;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 6px 0;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  .sash.diy span {
    background: #2e9d57;
  }
  .sash.tradie span {
    background: #d8342c;
  }
  .sash.none span {
    background: #3b4a5e;
    color: #c9d4e2;
  }
  .verdict-box {
    border-radius: 12px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .verdict-box.diy {
    border-color: rgba(63, 185, 107, 0.5);
  }
  .verdict-box.tradie {
    border-color: rgba(255, 90, 82, 0.55);
  }

  /* Shopping */
  .w-cols {
    display: grid;
    gap: 22px;
  }
  @media (min-width: 900px) {
    .w-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  .w-retailer h2 {
    font-size: 1.05rem;
    margin: 0 0 8px;
  }
  details.w-bought summary {
    cursor: pointer;
    color: var(--dim);
    font-weight: 700;
    margin: 18px 0 8px;
  }

  /* Gallery */
  .w-gallery {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
  .w-gallery button {
    padding: 0;
    border: 0;
    background: var(--surface);
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
    position: relative;
    aspect-ratio: 1;
  }
  .w-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .w-gallery .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 8px 6px;
    font-size: 0.75rem;
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
  }
  .w-lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.92);
    display: grid;
    place-items: center;
    padding: 20px;
    cursor: zoom-out;
  }
  .w-lightbox img {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 10px;
  }

  /* Account */
  .w-account {
    display: grid;
    gap: 14px;
    max-width: 620px;
  }
  .w-account .card p {
    margin: 4px 0 0;
  }

  .w-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 20px);
    background: var(--surface-2);
    color: #fff;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 700;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
    z-index: 70;
    max-width: calc(100% - 32px);
  }
  .w-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 640px) {
    .w-top {
      flex-wrap: wrap;
    }
    .w-top-slot {
      order: 3;
      flex-basis: 100%;
    }
    .hide-sm {
      display: none !important;
    }
  }
</style>
