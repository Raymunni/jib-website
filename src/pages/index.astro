---
import { getImage, Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SITE, HUBS, STORES, anyStoreLive } from '../config';
import heroWide from '../assets/hero/hero-wide.jpg';
import heroPhones from '../assets/hero/hero-phones.jpg';
import heroMobile from '../assets/hero/hero-mobile.jpg';
import shotSee from '../assets/screens/c1-see.png';
import shotPlan from '../assets/screens/c2-plan.png';
import shotCheck from '../assets/screens/c3-check.png';
import shotShop from '../assets/screens/c4-shop.png';
import shotWatch from '../assets/screens/c5-watch.png';
import { guideUrl } from '../lib/guides';
import howSnap from '../assets/how/1-snap.jpg';
import howPlan from '../assets/how/2-plan.jpg';
import howSee from '../assets/how/3-see.jpg';

const wideAvif = await getImage({ src: heroWide, format: 'avif', width: 2400, quality: 58 });
const wideWebp = await getImage({ src: heroWide, format: 'webp', width: 2400, quality: 72 });
const phonesAvif = await getImage({ src: heroPhones, format: 'avif', width: 900, quality: 58 });
const phonesWebp = await getImage({ src: heroPhones, format: 'webp', width: 900, quality: 72 });
const mobileWebp = await getImage({ src: heroMobile, format: 'webp', width: 900, quality: 70 });

const allGuides = await getCollection('guides');
// The three newest guides with a hero image.
const byNewest = allGuides.filter((g) => !g.data.pillar).sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.order - b.data.order);
const featured = byNewest.filter((g) => g.data.image).slice(0, 3);

const popular = [
  { href: '/guides/diy-legal/can-i-replace-a-tap-myself/', title: 'How to change a tap washer (and is it legal?)' },
  { href: '/guides/council-approval/fence-height-without-council-approval/', title: 'How high can a fence be without council approval?' },
  { href: '/guides/council-approval/shed-without-council-approval/', title: 'How big can a shed be without council approval?' },
  { href: '/guides/council-approval/deck-council-approval-nsw/', title: 'Do you need council approval for a deck or pergola in NSW?' },
  { href: '/guides/materials/timber-deck-materials-list/', title: 'Timber deck materials list, joist sizes included' },
];


// The eight things that sell Jib. Everything else lives in the features guide.
const featureTiles = [
  { icon: 'snap', href: '/guides/features/photo-to-job-plan/', title: 'Snap it, Jib plans it', body: 'One photo becomes a full job: steps, materials, tools, time and cost. No typing.' },
  { icon: 'beforeafter', href: '/guides/features/', title: 'See it finished first', body: 'Jib’s AI pictures your space with the work done, before you lift a tool.' },
  { icon: 'planner', href: '/guides/features/', title: 'Plan the whole space', body: 'A full look at a room or yard: every job it needs, in the right order, with the cost.' },
  { icon: 'climate', href: '/guides/features/', title: 'It knows your house', body: 'Age, soil, climate, termites. Every plan is written for your place, not a generic one.' },
  { icon: 'checker', href: '/guides/features/diy-or-tradie-verdict/', title: 'DIY safe or tradie required', body: 'Know if a job is legal to DIY where you live. If not, Jib writes the quote request.' },
  { icon: 'toolbox', href: '/guides/features/garage-tool-inventory/', title: 'AI tool inventory', body: 'Snap your shed once. Jib remembers what you own, so you never buy it twice.' },
  { icon: 'cart', href: '/guides/features/ai-shopping-list/', title: 'Real prices, one trip', body: 'Every job’s materials on one list, with real hardware store prices to compare.' },
  { icon: 'together', href: '/guides/features/shared-home-to-do-list/', title: 'Share the house', body: 'Your partner gets the same jobs, plans and list, live on their phone.' },
];

const shots = [
  { src: shotSee, alt: 'Jib app: see your space finished before you start' },
  { src: shotPlan, alt: 'Jib app: every job in the right order' },
  { src: shotCheck, alt: 'Jib app: DIY safe or a job for a tradie' },
  { src: shotShop, alt: 'Jib app: real prices, one trip' },
  { src: shotWatch, alt: 'Jib app: watch your home come together' },
];

// Three real-life moments, told with photos.
const spots = [
  {
    href: '/guides/features/photo-to-job-plan/',
    img: '/images/blog/photo-to-plan.jpg',
    alt: 'A mum with her toddler in a hip carrier photographs a cupboard door hanging off its hinge',
    eyebrow: 'Snap it now',
    title: 'Toddler on your hip? Just snap it.',
    body: 'Take a photo and get on with your day. Jib names the job, files it in the right room and writes the plan.',
  },
  {
    href: '/guides/features/quick-home-jobs-by-time/',
    img: '/images/blog/quick-jobs-base.jpg',
    alt: 'A mum rolling up her sleeves next to her drill, ready for a quick job',
    eyebrow: 'Do it when you can',
    title: 'Got 30 minutes? There’s a job for that.',
    body: 'Every job shows how long it takes, so a spare half hour turns into one less thing on the list.',
  },
  {
    href: '/guides/features/diy-or-tradie-verdict/',
    img: '/images/blog/verdict-base.jpg',
    alt: 'A dad crouched by a leaking outdoor tap, working out whether it needs a plumber',
    eyebrow: 'Stay on the right side of the rules',
    title: 'Know when to call a pro.',
    body: 'Red means a step legally needs a licensed tradie where you live. Jib writes the brief so getting quotes is easy.',
  },
];

const faqs = [
  {
    q: 'Is Jib free?',
    a: 'Jib is free to download, and you can track jobs, rooms, reminders and photos for free. The AI features, turning a photo into a full plan, materials list and cost estimate, and asking follow-up questions, are part of Jib’s paid plans, which come with a 7-day free trial.',
  },
  {
    q: 'Does Jib tell me if a job is legal to DIY?',
    a: 'Yes. On Jib’s paid plans, every job gets a corner flag: DIY safe (green) or tradie required (red), based on the licensing rules where your house is, with the exact step that needs a licence. It’s general guidance, not legal advice: always confirm with your state regulator or council. Our free DIY legality checker shows the rules for common jobs by state, with links to the regulator.',
  },
  {
    q: 'What is the AI tool inventory?',
    a: 'Photograph your garage, shed or a hardware receipt and Jib lists every tool it can see. After that, every job you plan checks your inventory, ticks off the tools you already own, and asks before adding any you’re missing to your shopping list. The AI tool inventory is part of Jib’s paid plans.',
  },
  {
    q: 'Is Jib only for Australia?',
    a: 'No. Jib works anywhere and supports AUD, USD, GBP, EUR, NZD and CAD. Our guides start with Australian rules because they vary so much between states, with UK and New Zealand guides alongside.',
  },
  {
    q: 'What phones does Jib run on?',
    a: 'iPhone (App Store) and Android (Google Play).',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Jib: DIY & Home Maintenance',
    alternateName: 'Jib: Home Improvement Planner',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    description: SITE.description,
    url: SITE.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Jib: DIY & Home Maintenance App with an AI Job Planner"
  description="The home jobs app for people with no time. Snap a photo and Jib writes the steps, shopping list and cost, and flags anything that legally needs a tradie."
  jsonLd={jsonLd}
>
  <section class="hero" style={`--hero-mobile:url(${mobileWebp.src})`}>
    <picture class="hero-img" aria-hidden="true">
      <source media="(min-width: 900px)" srcset={wideAvif.src} type="image/avif" />
      <source media="(min-width: 900px)" srcset={wideWebp.src} type="image/webp" />
      <img src={wideWebp.src} alt="" width="2400" height="1200" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap hero-copy">
      <span class="hero-logo"><img src="/images/jib-mark-navy.png" width="171" height="160" alt="" /><span>Jib</span></span>
      <h1>Your home, <span>sorted.</span></h1>
      <p class="hero-sub">The ultimate home planner, <b>with AI.</b></p>
      <p class="lede">
        Snap anything that needs doing. Jib writes the plan, the shopping list and the cost, shows you the finished result, and tells you if it’s DIY-legal or needs a tradie.
      </p>
      <div class="hero-ctas">
        <StoreButtons campaign="home" size="lg" />
      </div>
      <ul class="trust">
        <li>✓ Free to download</li>
        <li>✓ 7-day free trial of every AI feature</li>
        <li>✓ Built for Australian homes and rules</li>
      </ul>
    </div>
    <picture class="hero-phones">
      <source srcset={phonesAvif.src} type="image/avif" />
      <img src={phonesWebp.src} alt="The Jib app on two phones among DIY tools: the job list, and a backyard pictured finished by AI" width="1200" height="1024" decoding="async" />
    </picture>
  </section>

  <!-- 1. The app itself: the first thing under the hero is proof. -->
  <section class="screens" aria-labelledby="screens-title">
    <div class="wrap">
      <p class="eyebrow">Inside the app</p>
      <h2 id="screens-title" class="section-title">From “that needs fixing” to done.</h2>
    </div>
    <div class="shot-row" tabindex="0" aria-label="Jib app screens">
      {shots.map((s) => <Image src={s.src} alt={s.alt} widths={[280, 420, 560]} sizes="(max-width: 719px) 62vw, 220px" loading="lazy" class="shot" />)}
    </div>
  </section>

  <!-- 2. What it does: six features, not seventeen. -->
  <section class="wrap feats" aria-labelledby="feats-title">
    <p class="eyebrow">Everything in one app</p>
    <h2 id="feats-title" class="section-title feats-title">What Jib does</h2>
    <div class="feat-grid">
      {
        featureTiles.map((f) => (
          <a class="feat" href={f.href}>
            <ToolIcon name={f.icon} size={56} />
            <span class="feat-copy">
              <strong>{f.title}</strong>
              <span>{f.body}</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="all-feats"><a href="/guides/features/">See everything Jib does →</a></p>
  </section>

  <!-- 3. How it works: one backyard, start to finish, ending in the download. -->
  <section class="wrap how" aria-labelledby="how-title">
    <p class="eyebrow">How it works</p>
    <h2 id="how-title" class="section-title">One photo in. A finished yard out.</h2>
    <ol class="how-steps">
      <li class="how-step">
        <figure class="how-pic">
          <Image src={howSnap} alt="A phone photo of a bare dirt patch outside a back door" widths={[360, 540, 720]} sizes="(max-width: 759px) 90vw, 340px" loading="lazy" />
          <span class="how-tag">Your photo</span>
        </figure>
        <span class="how-n">1</span>
        <strong>Snap it</strong>
        <span>See something that needs doing? Take a photo and get on with your day.</span>
      </li>
      <li class="how-step">
        <figure class="how-pic">
          <Image src={howPlan} alt="Jib's plan for a back garden: 4 jobs, $681 to spend, the first phase Safety and structure" widths={[360, 540, 720]} sizes="(max-width: 759px) 90vw, 340px" loading="lazy" />
          <span class="how-tag">Jib's plan</span>
        </figure>
        <span class="how-n">2</span>
        <strong>Jib plans it</strong>
        <span>The steps, materials, cost and a DIY-or-tradie verdict, written for your house.</span>
      </li>
      <li class="how-step">
        <figure class="how-pic">
          <Image src={howSee} alt="The same back door with a new timber deck, chairs and a green lawn, pictured by Jib's AI" widths={[360, 540, 720]} sizes="(max-width: 759px) 90vw, 340px" loading="lazy" />
          <span class="how-tag ai">✦ AI preview</span>
        </figure>
        <span class="how-n">3</span>
        <strong>See it, then do it</strong>
        <span>See it finished before you start, then pick a weekend and everything’s on one list.</span>
      </li>
    </ol>
    <div class="how-cta">
      <StoreButtons campaign="home" size="lg" />
      <span class="how-free">Free to download. 7-day free trial of every AI feature.</span>
    </div>
  </section>

  <a class="mobile-cta" href="/app/?c=home" data-get-app>
    <span>Get Jib free</span><small>{STORES.ios.live && STORES.android.live ? 'iPhone & Android' : STORES.android.live ? 'On Android, iPhone soon' : 'Coming to iPhone & Android'}</small>
  </a>

  <!-- 4. Built for real life: three moments, side by side. -->
  <section class="wrap life" aria-labelledby="life-title">
    <p class="eyebrow">Made by a parent with no spare time</p>
    <h2 id="life-title" class="section-title">Built for the way busy homes actually work.</h2>
    <div class="spots">
      {
        spots.map((sp) => (
          <a class="card spot" href={sp.href}>
            <img src={sp.img} alt={sp.alt} width="1376" height="768" loading="lazy" decoding="async" />
            <div class="spot-copy">
              <p class="eyebrow">{sp.eyebrow}</p>
              <h3>{sp.title}</h3>
              <p>{sp.body}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap tool-promo" aria-labelledby="promo-title">
    <div class="promo">
      <div class="promo-copy">
        <p class="eyebrow">Free tool</p>
        <h2 id="promo-title">DIY or tradie? Check your state’s rules.</h2>
        <p>Pick the job. We’ll tell you if you can legally do it yourself, if it needs a licence or a certificate, and link the regulator that says so.</p>
        <div class="states" aria-label="Pick your state">
          {['QLD', 'NSW', 'VIC', 'WA', 'SA', 'TAS', 'ACT', 'NT'].map((st) => <a href={`/tools/diy-legality-checker/?state=${st}`}>{st}</a>)}
        </div>
      </div>
      <a class="verdicts" href="/tools/diy-legality-checker/" aria-label="Open the DIY checker">
        <span class="verdict ok"><b>Change a tap washer</b><em>✓ DIY safe in every state</em></span>
        <span class="verdict no"><b>Replace a power point</b><em>⚠ Licensed electrician only</em></span>
        <span class="verdict ok"><b>Build a low garden deck</b><em>✓ Usually DIY, check your council</em></span>
        <span class="verdict no"><b>Move the shower waste</b><em>⚠ Licensed plumber only</em></span>
        <span class="go">Open the DIY checker →</span>
      </a>
    </div>
  </section>

  <section class="wrap guides">
    <p class="eyebrow">Guides</p>
    <h2 class="section-title">Straight answers for real jobs</h2>
    <div class="hubs">
      {
        Object.entries(HUBS).map(([key, hub]) => (
          <a class="hub" href={`/guides/${key}/`}>{hub.title} <span aria-hidden="true">→</span></a>
        ))
      }
    </div>
    <!-- Direct links to the guides Google has started showing in search. -->
    <ul class="popular" aria-label="Popular answers">
      {popular.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
    </ul>
    {
      featured.length > 0 && (
        <div class="grid grid-3 featured">
          {featured.map((g) => (
            <a class="card fcard" href={guideUrl(g)}>
              <img src={g.data.image} alt="" width="1376" height="768" loading="lazy" decoding="async" />
              <strong>{g.data.title}</strong>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="wrap faq">
    <h2 class="section-title">Questions</h2>
    {
      faqs.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section class="wrap final">
    <div class="final-card">
      <img src="/images/jib-mark.png" width="56" height="56" alt="" />
      <h2>Your home, sorted.</h2>
      <p>Snap it, see it finished, plan it, and know when to call a pro.</p>
      <StoreButtons campaign="home" size="lg" />
    </div>
  </section>
</Base>

<style>
  .popular {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }
  .popular a {
    font-weight: 600;
  }
  .ios-notify {
    display: block;
    width: 100%;
    margin-top: 10px;
    font-size: 0.92rem;
    opacity: 0.85;
  }
  /* Hero: the flat-lay on light concrete, so the type is dark ink. On
     desktop the photo fills the band with the phones on the right; on
     phones the copy comes first and the phones sit under it. */
  .hero {
    position: relative;
    overflow: hidden;
    background: #d9dad7;
    color: #1d2530;
  }
  .hero-img {
    display: none;
  }
  /* On phones the tools run along the top edge, the copy sits on the bare
     concrete under them, then the sticky notes and the phones. */
  .hero-copy {
    position: relative;
    padding-top: 30vw;
    padding-bottom: 8px;
    max-width: none;
  }
  @media (max-width: 899px) {
    .hero {
      background: #d9dad7 var(--hero-mobile) center top / 100% auto no-repeat;
    }
  }
  .hero-notes {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 4vw;
    margin: 18px 0 -16vw;
  }
  .hero-notes img {
    width: 40vw;
    height: auto;
  }
  .hero-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.22em;
    font-family: 'Nunito', system-ui, sans-serif;
    font-weight: 550;
    font-size: clamp(3rem, 7vw, 4.6rem);
    line-height: 1;
    color: #1b365d;
  }
  .hero-logo img {
    width: auto;
    height: 0.86em;
  }
  .hero h1,
  .hero-sub {
    font-family: 'Nunito', system-ui, sans-serif;
  }
  .hero h1 {
    margin: 18px 0 0;
    font-size: clamp(2.3rem, 5.6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #14181f;
    white-space: nowrap;
  }
  .hero h1 span {
    color: #1f5fd6;
  }
  .hero-sub {
    margin: 10px 0 0;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-weight: 500;
    color: #3a414c;
  }
  .hero-sub b {
    font-weight: 700;
    background: linear-gradient(90deg, #3b6ff0, #8b4fe0, #e2569c);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: 1.08rem;
    color: #2b313a;
    max-width: 44ch;
    margin-top: 16px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 0;
    margin: 16px 0 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #3a414c;
  }
  .hero-phones img {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 6%);
    mask-image: linear-gradient(180deg, transparent 0, #000 6%);
    display: block;
    width: 100%;
    height: auto;
    margin-top: 8px;
  }
  @media (min-width: 900px) {
    .hero {
      min-height: min(50vw, 900px);
      display: flex;
      align-items: flex-start;
    }
    .hero-img,
    .hero-img img {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 30%;
    }
    .hero-phones {
      display: none;
    }
    /* On desktop the photo carries the tools; the copy is plain and sits high,
       and the notes lie on the concrete between the copy and the phones. */
    /* The copy sits to the left, on the bare concrete above the gloves. */
    .hero-copy {
      max-width: none;
      margin: 0;
      padding-left: 15.5vw;
      padding-right: 32px;
      width: fit-content;
    }
    .hero-notes {
      position: absolute;
      left: 40%;
      top: 34%;
      margin: 0;
      gap: 0;
    }
    .hero-notes img {
      width: clamp(110px, 9.5vw, 180px);
    }
    @media (max-width: 1199px) {
      .hero-notes {
        display: none;
      }
    }
    .hero-notes img + img {
      margin-left: -1.5vw;
      margin-top: 4.5vw;
    }
    .hero-copy {
      z-index: 2;
    }
    .hero-copy {
      padding-top: clamp(20px, 2.2vw, 44px);
      padding-bottom: 48px;
    }
    .hero-copy > .lede,
    .hero-copy > .trust,
    .hero-copy > .hero-ctas {
      max-width: 32vw;
    }
    /* The copy scales with the screen, so it always fits between the
       gloves and the phones. */
    .hero-logo {
      font-size: min(4.4vw, 5rem);
    }
    .hero h1 {
      font-size: min(3.6vw, 4.4rem);
    }
    .hero-sub {
      font-size: min(1.6vw, 1.85rem);
    }
    .lede {
      font-size: clamp(0.92rem, 1.05vw, 1.2rem);
    }
    .trust {
      font-size: clamp(0.8rem, 0.85vw, 1rem);
    }
  }
  .section-title {
    margin: 4px 0 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  /* 1. App screens: one swipeable row on phones, all five across on desktop */
  .screens {
    margin-top: 56px;
  }
  .shot-row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 24px max(16px, calc((100vw - var(--maxw, 1180px)) / 2 + 20px)) 8px;
    scrollbar-width: none;
  }
  .shot-row::-webkit-scrollbar {
    display: none;
  }
  :global(.shot-row .shot) {
    flex: 0 0 62vw;
    max-width: 260px;
    height: auto;
    border-radius: 18px;
    scroll-snap-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  @media (min-width: 900px) {
    .shot-row {
      justify-content: center;
      overflow: visible;
    }
    :global(.shot-row .shot) {
      flex: 0 1 210px;
    }
  }

  /* 2. Six features */
  .feats {
    margin-top: 56px;
  }
  .feats-title {
    margin-bottom: 18px;
  }
  .feat-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .feat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .feat {
      flex-direction: column;
