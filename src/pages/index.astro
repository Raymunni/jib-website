---
import { getImage, Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SITE, HUBS, STORES, anyStoreLive } from '../config';
import heroWide from '../assets/hero/a.jpg';
import heroTall from '../assets/hero/b.jpg';
import shotPlan from '../assets/screens/01-plan.png';
import shotTrack from '../assets/screens/02-track.png';
import shotCatch from '../assets/screens/03-catch.png';
import shotShop from '../assets/screens/04-shop.png';
import shotSee from '../assets/screens/05-see.png';
import { guideUrl } from '../lib/guides';

const wideAvif = await getImage({ src: heroWide, format: 'avif', width: 1376, quality: 60 });
const wideWebp = await getImage({ src: heroWide, format: 'webp', width: 1376, quality: 72 });
const tallAvif = await getImage({ src: heroTall, format: 'avif', width: 768, quality: 60 });
const tallWebp = await getImage({ src: heroTall, format: 'webp', width: 768, quality: 72 });

const allGuides = await getCollection('guides');
// The three newest guides with a hero image.
const byNewest = allGuides.filter((g) => !g.data.pillar).sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.order - b.data.order);
const featured = byNewest.filter((g) => g.data.image).slice(0, 3);


// The six things that sell Jib. Everything else lives in the features guide.
const featureTiles = [
  { icon: 'snap', href: '/guides/features/photo-to-job-plan/', title: 'Snap it, AI plans it', body: 'One photo becomes a full job: steps, materials, tools, time and cost. No typing.' },
  { icon: 'checker', href: '/guides/features/diy-or-tradie-verdict/', title: 'DIY safe or tradie required', body: 'Know before you start if a job is legal to DIY where you live, and which step needs a licence.' },
  { icon: 'cart', href: '/guides/features/ai-shopping-list/', title: 'One trip to the hardware store', body: 'Every job’s materials on one list, by store. It skips the tools you already own.' },
  { icon: 'voice', href: '/guides/features/add-home-jobs-by-voice/', title: 'Hands full? Just say it', body: 'Tap the mic, say the job, and Jib files it in the right room.' },
  { icon: 'together', href: '/guides/features/shared-home-to-do-list/', title: 'Plan it together', body: 'Share your house with your partner. Same jobs and list on both phones.' },
  { icon: 'beforeafter', href: '/guides/features/before-and-after-photos/', title: 'See your home get better', body: 'Before and after photos on a timeline for every room. Gold when you sell.' },
];

const shots = [
  { src: shotPlan, alt: 'Jib app: snap a photo and AI plans the whole job' },
  { src: shotTrack, alt: 'Jib app: every job, every room, at a glance' },
  { src: shotCatch, alt: 'Jib app: know if a job is DIY safe before you start' },
  { src: shotShop, alt: 'Jib app: one shopping list for every job' },
  { src: shotSee, alt: 'Jib app: a timeline of your home, before and after' },
];

// Three real-life moments, told with photos.
const spots = [
  {
    href: '/guides/features/photo-to-job-plan/',
    img: '/images/blog/photo-to-plan.jpg',
    alt: 'A parent holding a toddler snaps a photo of a crooked cupboard door',
    eyebrow: 'Snap it now',
    title: 'Toddler on your hip? Just snap it.',
    body: 'Take a photo and get on with your day. Jib names the job, files it in the right room and writes the plan.',
  },
  {
    href: '/guides/features/quick-home-jobs-by-time/',
    img: '/images/blog/quick-jobs.jpg',
    alt: 'A dad tightening a cupboard hinge while a child plays nearby',
    eyebrow: 'Do it when you can',
    title: 'Got 30 minutes? There’s a job for that.',
    body: 'Every job shows how long it takes, so a spare half hour turns into one less thing on the list.',
  },
  {
    href: '/guides/features/diy-or-tradie-verdict/',
    img: '/images/blog/diy-or-tradie-flag.jpg',
    alt: 'A phone with a red corner flag held up in front of an opened power point',
    eyebrow: 'Stay on the right side of the rules',
    title: 'Know when to call a pro.',
    body: 'Red means a step legally needs a licensed tradie where you live. Jib writes the brief so getting quotes is easy.',
  },
];

const faqs = [
  {
    q: 'Is Jib free?',
    a: 'Jib is free to download, and you can track jobs, rooms, reminders and photos for free. The AI features, turning a photo into a full plan, materials list and cost estimate, and asking follow-up questions, are part of Jib’s paid plans, which come with a 7-day free trial.',
  },
  {
    q: 'Does Jib tell me if a job is legal to DIY?',
    a: 'Yes. On Jib’s paid plans, every job gets a corner flag: DIY safe (green) or tradie required (red), based on the licensing rules where your house is, with the exact step that needs a licence. It’s general guidance, not legal advice: always confirm with your state regulator or council. Our free DIY legality checker shows the rules for common jobs by state, with links to the regulator.',
  },
  {
    q: 'What is the AI Toolbox?',
    a: 'Photograph your garage, shed or a hardware receipt and Jib lists every tool it can see. After that, every job you plan checks your Toolbox, ticks off the tools you already own, and asks before adding any you’re missing to your shopping list. The AI Toolbox is part of Jib’s paid plans.',
  },
  {
    q: 'Is Jib only for Australia?',
    a: 'No. Jib works anywhere and supports AUD, USD, GBP, EUR, NZD and CAD. Our guides start with Australian rules because they vary so much between states, with UK and New Zealand guides alongside.',
  },
  {
    q: 'What phones does Jib run on?',
    a: 'iPhone (App Store) and Android (Google Play).',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Jib: Home Improvement Planner',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    description: SITE.description,
    url: SITE.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Jib: snap any home job and AI plans the rest"
  description="The home jobs app for people with no time. Snap a photo and Jib writes the steps, shopping list and cost, and flags anything that legally needs a tradie."
  jsonLd={jsonLd}
>
  <section class="hero">
    <picture class="hero-img">
      <source media="(max-width: 719px)" srcset={tallAvif.src} type="image/avif" />
      <source media="(max-width: 719px)" srcset={tallWebp.src} type="image/webp" />
      <source srcset={wideAvif.src} type="image/avif" />
      <img src={wideWebp.src} alt="Holding a phone up in front of a Queenslander house at golden hour, with a paintbrush and spirit level on the deck" width="1376" height="768" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">The home jobs app for people with no time</p>
      <h1>See a job. Snap it.<br /><span>Jib does the rest.</span></h1>
      <p class="lede">
        Photograph anything around the house that needs doing. Jib’s AI writes the plan, the shopping list and the cost, and tells you if it’s DIY-legal or needs a tradie. Then pick a job whenever you’ve got a spare hour.
      </p>
      <div class="hero-ctas">
        {
          anyStoreLive ? (
            <>
              <StoreButtons campaign="home" size="lg" />
              {!STORES.ios.live && (
                <a class="ios-notify" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Tell me when Jib is on iPhone')}&body=${encodeURIComponent('Please email me when Jib is on the App Store.')}`}>On iPhone? Get an email when it’s on the App Store</a>
              )}
            </>
          ) : (
            <>
              <a class="btn btn-primary" href="/app/" data-get-app>Get it on your phone</a>
              <a class="btn btn-ghost" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Tell me when Jib launches')}&body=${encodeURIComponent('Please email me when Jib is on the App Store / Google Play. My phone is: iPhone / Android')}`}>Tell me when it launches</a>
            </>
          )
        }
      </div>
      <ul class="trust">
        <li>✓ Free to download</li>
        <li>✓ 7-day free trial of every AI feature</li>
        <li>✓ Built for Australian homes and rules</li>
      </ul>
    </div>
  </section>

  <!-- 1. The app itself: the first thing under the hero is proof. -->
  <section class="screens" aria-labelledby="screens-title">
    <div class="wrap">
      <p class="eyebrow">Inside the app</p>
      <h2 id="screens-title" class="section-title">From “that needs fixing” to done.</h2>
    </div>
    <div class="shot-row" tabindex="0" aria-label="Jib app screens">
      {shots.map((s) => <Image src={s.src} alt={s.alt} widths={[280, 420, 560]} sizes="(max-width: 719px) 62vw, 220px" loading="lazy" class="shot" />)}
    </div>
  </section>

  <!-- 2. What it does: six features, not seventeen. -->
  <section class="wrap feats" aria-labelledby="feats-title">
    <h2 id="feats-title" class="section-title feats-title">What Jib does</h2>
    <div class="feat-grid">
      {
        featureTiles.map((f) => (
          <a class="feat" href={f.href}>
            <ToolIcon name={f.icon} size={56} />
            <span class="feat-copy">
              <strong>{f.title}</strong>
              <span>{f.body}</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="all-feats"><a href="/guides/features/">See everything Jib does →</a></p>
  </section>

  <!-- 3. How it works, ending in the download. -->
  <section class="wrap how" aria-labelledby="how-title">
    <h2 id="how-title" class="how-title">Three steps. No lists, no research.</h2>
    <ol class="how-steps">
      <li><span class="how-n">1</span><strong>Snap it</strong><span>See something that needs doing? Take a photo and get on with your day.</span></li>
      <li><span class="how-n">2</span><strong>Jib plans it</strong><span>AI writes the steps, materials, tools, cost and a DIY-or-tradie verdict.</span></li>
      <li><span class="how-n">3</span><strong>Do it when you can</strong><span>Got a spare hour? Pick a job that fits, with everything on one shopping list.</span></li>
    </ol>
    <div class="how-cta">
      {
        anyStoreLive ? (
          <StoreButtons campaign="home" size="lg" />
        ) : (
          <>
            <a class="btn btn-light" href="/app/" data-get-app>Get it on your phone</a>
            <a class="btn btn-ghost" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Tell me when Jib launches')}&body=${encodeURIComponent('Please email me when Jib is on the App Store / Google Play. My phone is: iPhone / Android')}`}>Tell me when it’s on the App Store</a>
          </>
        )
      }
    </div>
  </section>

  <a class="mobile-cta" href="/app/?c=home" data-get-app>
    <span>Get Jib free</span><small>{STORES.ios.live && STORES.android.live ? 'iPhone & Android' : STORES.android.live ? 'On Android, iPhone soon' : 'Coming to iPhone & Android'}</small>
  </a>

  <!-- 4. Built for real life: three moments, side by side. -->
  <section class="wrap life" aria-labelledby="life-title">
    <p class="eyebrow">Made by a parent with no spare time</p>
    <h2 id="life-title" class="section-title">Built for the way busy homes actually work.</h2>
    <div class="spots">
      {
        spots.map((sp) => (
          <a class="card spot" href={sp.href}>
            <img src={sp.img} alt={sp.alt} width="1376" height="768" loading="lazy" decoding="async" />
            <div class="spot-copy">
              <p class="eyebrow">{sp.eyebrow}</p>
              <h3>{sp.title}</h3>
              <p>{sp.body}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap tool-promo">
    <div class="card promo">
      <div>
        <p class="eyebrow">Free tool</p>
        <h2>DIY or tradie? Check the rules for your state.</h2>
        <p>Pick your state and the job. We’ll tell you if you can legally do it yourself, if you need a licence or a certificate, and link the regulator that says so.</p>
      </div>
      <a class="btn btn-light" href="/tools/diy-legality-checker/">Open the DIY checker</a>
    </div>
  </section>

  <section class="wrap guides">
    <p class="eyebrow">Guides</p>
    <h2 class="section-title">Straight answers for real jobs</h2>
    <div class="hubs">
      {
        Object.entries(HUBS).map(([key, hub]) => (
          <a class="hub" href={`/guides/${key}/`}>{hub.title} <span aria-hidden="true">→</span></a>
        ))
      }
    </div>
    {
      featured.length > 0 && (
        <div class="grid grid-3 featured">
          {featured.map((g) => (
            <a class="card fcard" href={guideUrl(g)}>
              <img src={g.data.image} alt="" width="1376" height="768" loading="lazy" decoding="async" />
              <strong>{g.data.title}</strong>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="wrap faq">
    <h2 class="section-title">Questions</h2>
    {
      faqs.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section class="wrap final">
    <div class="final-card">
      <img src="/images/jib-mark.png" width="56" height="56" alt="" />
      <h2>Your next job, planned properly.</h2>
      <p>Snap it, plan it, buy what you need, and know when to call a pro.</p>
      <StoreButtons campaign="home" size="lg" />
    </div>
  </section>
</Base>

<style>
  .ios-notify {
    display: block;
    width: 100%;
    margin-top: 10px;
    font-size: 0.92rem;
    opacity: 0.85;
  }
  .hero {
    position: relative;
    min-height: min(70vh, 620px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-img,
  .hero-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 24, 36, 0.1) 0%, rgba(14, 24, 36, 0.35) 40%, rgba(14, 24, 36, 0.95) 100%);
  }
  @media (min-width: 720px) {
    .hero {
      align-items: center;
    }
    .hero-shade {
      background: linear-gradient(90deg, rgba(14, 24, 36, 0.95) 0%, rgba(14, 24, 36, 0.75) 40%, rgba(14, 24, 36, 0.1) 75%),
        linear-gradient(180deg, transparent 70%, var(--bg) 100%);
    }
  }
  .hero-copy {
    position: relative;
    padding-top: 84px;
    padding-bottom: 72px;
    width: 100%;
  }
  .hero h1 {
    max-width: 20ch;
    font-size: clamp(2.2rem, 5.2vw, 3.5rem);
  }
  .hero h1 span {
    color: #9cc2ff;
  }
  .lede {
    font-size: 1.15rem;
    color: #e3eaf2;
    max-width: 46ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 0;
    margin: 18px 0 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #d7e6fb;
  }
  .section-title {
    margin: 4px 0 0;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  /* 1. App screens: one swipeable row on phones, all five across on desktop */
  .screens {
    margin-top: 56px;
  }
  .shot-row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 24px max(16px, calc((100vw - var(--maxw, 1180px)) / 2 + 20px)) 8px;
    scrollbar-width: none;
  }
  .shot-row::-webkit-scrollbar {
    display: none;
  }
  :global(.shot-row .shot) {
    flex: 0 0 62vw;
    max-width: 260px;
    height: auto;
    border-radius: 18px;
    scroll-snap-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  @media (min-width: 900px) {
    .shot-row {
      justify-content: center;
      overflow: visible;
    }
    :global(.shot-row .shot) {
      flex: 0 1 210px;
    }
  }

  /* 2. Six features */
  .feats {
    margin-top: 56px;
  }
  .feats-title {
    margin-bottom: 18px;
  }
  .feat-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .feat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  .feat {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .feat:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    color: var(--text);
  }
  .feat-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .feat-copy strong {
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .feat-copy span {
    color: var(--dim);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .all-feats {
    margin: 16px 0 0;
    font-weight: 700;
  }
  .all-feats a {
    color: var(--accent-2);
    text-decoration: none;
  }

  /* 3. How it works */
  .how {
    margin-top: 64px;
    background: linear-gradient(135deg, var(--accent-deep), #173a6b);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    padding: 28px;
  }
  .how-title {
    margin: 0 0 22px;
    color: #fff;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
  }
  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 760px) {
    .how-steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .how-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: start;
  }
  .how-steps strong {
    color: #fff;
    font-size: 1.15rem;
  }
  .how-steps li > span:last-child {
    grid-column: 2;
    color: #dbe7f7;
    font-size: 0.95rem;
  }
  .how-n {
    grid-row: span 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: var(--accent-deep);
    font-weight: 900;
    display: grid;
    place-items: center;
  }
  .how-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .how-cta .btn-ghost {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .btn-light {
    background: #fff;
    color: var(--accent-deep);
    font-weight: 800;
  }
  .btn-light:hover {
    color: var(--accent-deep);
  }

  /* Sticky call to action on phones */
  .mobile-cta {
    display: none;
  }
  @media (max-width: 719px) {
    .mobile-cta {
      position: fixed;
      z-index: 30;
      left: 12px;
      right: 12px;
      bottom: 12px;
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 8px;
      padding: 14px 16px;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      text-decoration: none;
      font-weight: 800;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }
    .mobile-cta small {
      font-weight: 600;
      opacity: 0.85;
    }
    .mobile-cta:hover {
      color: #fff;
    }
    :global(body) {
      padding-bottom: 76px;
    }
  }

  /* 4. Real life: three cards, swipe on phones */
  .life {
    margin-top: 80px;
  }
  .spots {
    margin-top: 22px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: -16px;
    padding: 0 16px 6px;
  }
  .spots::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 820px) {
    .spots {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
      gap: 18px;
    }
  }
  .spot {
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    transition: border-color 0.15s ease;
  }
  .spot:hover {
    border-color: var(--accent-2);
    color: var(--text);
  }
  .spot img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .spot-copy {
    padding: 18px 20px 22px;
  }
  .spot-copy h3 {
    margin: 0 0 8px;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .spot-copy p:last-child {
    margin: 0;
    color: var(--dim);
    font-size: 0.95rem;
  }

  .tool-promo {
    margin-top: 80px;
  }
  .promo {
    display: grid;
    gap: 20px;
    align-items: center;
    padding: 32px;
    background: linear-gradient(135deg, var(--accent-deep), #173a6b);
    border-color: rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 720px) {
    .promo {
      grid-template-columns: 1fr auto;
    }
  }
  .promo h2 {
    margin-top: 0;
  }
  .promo p {
    color: #dbe7f7;
    margin-bottom: 0;
  }

  .guides {
    margin-top: 80px;
  }
  .hubs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .hub {
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
