---
import { getImage, Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { SITE, HUBS } from '../config';
import heroWide from '../assets/hero/a.jpg';
import heroTall from '../assets/hero/b.jpg';
import shotPlan from '../assets/screens/01-plan.png';
import shotTrack from '../assets/screens/02-track.png';
import shotCatch from '../assets/screens/03-catch.png';
import shotShop from '../assets/screens/04-shop.png';
import shotSee from '../assets/screens/05-see.png';
import { guideUrl } from '../lib/guides';

const wideAvif = await getImage({ src: heroWide, format: 'avif', width: 1376, quality: 60 });
const wideWebp = await getImage({ src: heroWide, format: 'webp', width: 1376, quality: 72 });
const tallAvif = await getImage({ src: heroTall, format: 'avif', width: 768, quality: 60 });
const tallWebp = await getImage({ src: heroTall, format: 'webp', width: 768, quality: 72 });

const allGuides = await getCollection('guides');
// Newest guides with a hero image lead the home page as cards; the rest as links.
const byNewest = allGuides.filter((g) => !g.data.pillar).sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.order - b.data.order);
const featured = byNewest.filter((g) => g.data.image).slice(0, 6);
const guides = byNewest.filter((g) => !featured.includes(g)).slice(0, 8);

const features = [
  {
    shot: shotPlan,
    eyebrow: 'Plan',
    title: 'Snap a photo, get the full job',
    body: 'Photograph the job and Jib drafts the steps, the materials list and a cost range — so you know what you are signing up for before the first trip to the hardware store.',
  },
  {
    shot: shotCatch,
    eyebrow: 'Catch',
    title: 'DIY safe, or tradie required?',
    body: 'Every job gets a verdict in its corner: green for DIY safe, red when a step legally needs a licensed electrician, plumber or gasfitter where you live — so you do the bits you can and book a pro for the bits you can’t.',
  },
  {
    shot: shotShop,
    eyebrow: 'Shop',
    title: 'Only buy the tools you don’t own',
    body: 'Jib knows what’s in your Toolbox, so every job shows which tools you already have and which you’d need to buy. Missing tools and materials roll into one shopping list, grouped by store.',
  },
  {
    shot: shotTrack,
    eyebrow: 'Track',
    title: 'Every job, every room, one glance',
    body: 'Keep jobs organised by room, set reminders for the recurring ones, and see what’s done and what’s next.',
  },
  {
    shot: shotSee,
    eyebrow: 'See',
    title: 'Before and after, room by room',
    body: 'Photos land in a gallery and a timeline of your home — the record of what you’ve changed, handy when you sell.',
  },
];

const faqs = [
  {
    q: 'Is Jib free?',
    a: 'Jib is free to download, and you can track jobs, rooms, reminders and photos for free. The AI features — turning a photo into a full plan, materials list and cost estimate, and asking follow-up questions — are part of Jib’s paid plans, which come with a 7-day free trial.',
  },
  {
    q: 'Does Jib tell me if a job is legal to DIY?',
    a: 'Yes. On Jib’s paid plans, every job gets a corner flag: DIY safe (green) or tradie required (red), based on the licensing rules where your house is, with the exact step that needs a licence. It’s general guidance, not legal advice: always confirm with your state regulator or council. Our free DIY legality checker shows the rules for common jobs by state, with links to the regulator.',
  },
  {
    q: 'What is the AI Toolbox?',
    a: 'Photograph your garage, shed or a hardware receipt and Jib lists every tool it can see. After that, every job you plan checks your Toolbox, ticks off the tools you already own, and asks before adding any you’re missing to your shopping list. The AI Toolbox is part of Jib’s paid plans.',
  },
  {
    q: 'Is Jib only for Australia?',
    a: 'No — Jib works anywhere and supports AUD, USD, GBP, EUR, NZD and CAD. Our guides start with Australian rules because they vary so much between states, with UK and New Zealand guides alongside.',
  },
  {
    q: 'What phones does Jib run on?',
    a: 'iPhone (App Store) and Android (Google Play).',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Jib: Home Improvement Planner',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    description: SITE.description,
    url: SITE.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Jib — Snap a photo, get the full DIY job plan"
  description="Photograph any home job and Jib drafts the steps, materials list and cost — and flags the parts that legally need a licensed tradie in your state."
  jsonLd={jsonLd}
>
  <section class="hero">
    <picture class="hero-img">
      <source media="(max-width: 719px)" srcset={tallAvif.src} type="image/avif" />
      <source media="(max-width: 719px)" srcset={tallWebp.src} type="image/webp" />
      <source srcset={wideAvif.src} type="image/avif" />
      <img src={wideWebp.src} alt="Holding a phone up in front of a Queenslander house at golden hour, with a paintbrush and spirit level on the deck" width="1376" height="768" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">The DIY job planner</p>
      <h1>Can you DIY it?<br /><span>Snap a photo and find out.</span></h1>
      <p class="lede">
        Jib turns a photo of any home job into a full plan — steps, materials and cost — and flags the parts that legally need a licensed tradie in your state.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/app/" data-get-app>Get Jib free</a>
        <a class="btn btn-ghost" href="/tools/diy-legality-checker/">Try the free DIY checker</a>
      </div>
    </div>
  </section>

  <section class="wrap strip">
    <div class="card strip-item"><strong>Photo → plan</strong><span class="muted">Steps, materials &amp; cost in seconds</span></div>
    <div class="card strip-item"><strong>DIY or tradie</strong><span class="muted">A legal verdict on every job</span></div>
    <div class="card strip-item"><strong>AI Toolbox</strong><span class="muted">Scan your shed, buy only what’s missing</span></div>
    <div class="card strip-item"><strong>Before &amp; after</strong><span class="muted">A timeline of your home</span></div>
  </section>

  <section class="wrap spotlight" aria-label="New in Jib">
    <a class="card spot" href="/guides/features/garage-tool-inventory/">
      <img src="/images/blog/toolbox-garage-scan.jpg" alt="Holding a phone up to a garage pegboard while the app outlines each tool it recognises" width="1376" height="768" loading="lazy" decoding="async" />
      <div class="spot-copy">
        <p class="eyebrow">AI Toolbox</p>
        <h2>One photo of your shed. Every tool, remembered.</h2>
        <p>Scan your garage, shed or a hardware receipt and Jib lists every tool it sees. Every job after that knows what you own — and asks before adding the tools you’re missing to your shopping list.</p>
        <span class="more">How the AI Toolbox works →</span>
      </div>
    </a>
    <a class="card spot" href="/guides/features/diy-or-tradie-verdict/">
      <img src="/images/blog/diy-or-tradie-flag.jpg" alt="A phone with a red corner flag held up in front of an opened power point" width="1376" height="768" loading="lazy" decoding="async" />
      <div class="spot-copy">
        <p class="eyebrow">DIY safe · Tradie required</p>
        <h2>A legal verdict in the corner of every job.</h2>
        <p>Green means it’s yours to do. Red means a step legally needs a licensed electrician, plumber or gasfitter where you live — and Jib tells you exactly which one.</p>
        <span class="more">How the verdict works →</span>
      </div>
    </a>
  </section>

  <section class="wrap features" aria-label="What Jib does">
    {
      features.map((f, i) => (
        <article class={`feature ${i % 2 ? 'flip' : ''}`}>
          <div class="feature-copy">
            <p class="eyebrow">{f.eyebrow}</p>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </div>
          <Image src={f.shot} alt={`Jib app screen: ${f.title}`} widths={[320, 480]} sizes="(max-width: 719px) 70vw, 320px" loading="lazy" class="shot" />
        </article>
      ))
    }
  </section>

  <section class="wrap tool-promo">
    <div class="card promo">
      <div>
        <p class="eyebrow">Free tool</p>
        <h2>DIY or tradie? Check the rules for your state.</h2>
        <p>Pick your state and the job. We’ll tell you whether you can legally do it yourself, whether you need a licence or a compliance certificate — and link the regulator that says so.</p>
      </div>
      <a class="btn btn-primary" href="/tools/diy-legality-checker/">Open the DIY checker</a>
    </div>
  </section>

  <section class="wrap">
    <p class="eyebrow">Guides</p>
    <h2 class="section-title">Straight answers for real jobs</h2>
    <div class="grid grid-3 hubs">
      {
        Object.entries(HUBS).map(([key, hub]) => (
          <a class="card hub" href={`/guides/${key}/`}>
            <h3>{hub.title}</h3>
            <p class="muted">{hub.blurb}</p>
            <span class="more">Browse guides →</span>
          </a>
        ))
      }
    </div>
    {
      featured.length > 0 && (
        <div class="grid grid-3 featured">
          {featured.map((g) => (
            <a class="card fcard" href={guideUrl(g)}>
              <img src={g.data.image} alt="" width="1376" height="768" loading="lazy" decoding="async" />
              <strong>{g.data.title}</strong>
            </a>
          ))}
        </div>
      )
    }
    {
      guides.length > 0 && (
        <ul class="latest">
          {guides.map((g) => (
            <li>
              <a href={guideUrl(g)}>{g.data.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wrap faq">
    <h2 class="section-title">Questions</h2>
    {
      faqs.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section class="wrap final">
    <div class="card final-card">
      <h2>Your next job, planned properly.</h2>
      <p class="muted">Snap it, plan it, buy what you need, and know when to call a pro.</p>
      <StoreButtons campaign="home" size="lg" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-img,
  .hero-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 24, 36, 0.1) 0%, rgba(14, 24, 36, 0.35) 40%, rgba(14, 24, 36, 0.95) 100%);
  }
  @media (min-width: 720px) {
    .hero {
      align-items: center;
    }
    .hero-shade {
      background: linear-gradient(90deg, rgba(14, 24, 36, 0.95) 0%, rgba(14, 24, 36, 0.75) 40%, rgba(14, 24, 36, 0.1) 75%),
        linear-gradient(180deg, transparent 70%, var(--bg) 100%);
    }
  }
  .hero-copy {
    position: relative;
    padding-top: 120px;
    padding-bottom: 56px;
    width: 100%;
  }
  .hero h1 {
    max-width: 14ch;
    font-size: clamp(2.3rem, 6vw, 3.8rem);
  }
  .hero h1 span {
    color: #9cc2ff;
  }
  .lede {
    font-size: 1.15rem;
    color: #e3eaf2;
    max-width: 46ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 20px;
  }
  @media (min-width: 900px) {
    .strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
  }
  .strip-item span {
    font-size: 0.9rem;
  }
  .spotlight {
    margin-top: 56px;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .spotlight {
      grid-template-columns: 1fr 1fr;
    }
  }
  .spot {
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }
  .spot:hover {
    border-color: var(--accent-2);
    color: var(--text);
  }
  .spot img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .spot-copy {
    padding: 22px 24px 26px;
  }
  .spot-copy h2 {
    margin: 0 0 10px;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
  }
  .features {
    margin-top: 72px;
    display: grid;
    gap: 72px;
  }
  .feature {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 720px) {
    .feature {
      grid-template-columns: 1fr 320px;
      gap: 64px;
    }
    .feature.flip {
      grid-template-columns: 320px 1fr;
    }
    .feature.flip .feature-copy {
      order: 2;
    }
  }
  .feature h2 {
    margin-top: 0;
  }
  .feature-copy p:last-child {
    max-width: 48ch;
  }
  :global(.shot) {
    width: 70%;
    max-width: 320px;
    margin: 0 auto;
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .tool-promo {
    margin-top: 96px;
  }
  .promo {
    display: grid;
    gap: 20px;
    align-items: center;
    padding: 32px;
    background: linear-gradient(135deg, var(--accent-deep), #173a6b);
    border-color: rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 720px) {
    .promo {
      grid-template-columns: 1fr auto;
    }
  }
  .promo h2 {
    margin-top: 0;
  }
  .promo p {
    color: #dbe7f7;
    margin-bottom: 0;
  }
  .section-title {
    margin-top: 0;
  }
  .wrap > .eyebrow {
    margin-top: 96px;
  }
  .hubs {
    margin-top: 20px;
  }
  .hub {
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease;
  }
  .hub:hover {
    border-color: var(--accent-2);
    color: var(--text);
  }
  .hub h3 {
    margin: 0 0 8px;
  }
  .more {
    color: var(--accent-2);
    font-weight: 700;
  }
  .featured {
    margin-top: 24px;
  }
  .fcard {
    padding: 0 0 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .fcard:hover {
    border-color: var(--accent-2);
    color: var(--ink);
  }
  .fcard img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .fcard strong {
    padding: 0 16px;
    line-height: 1.35;
  }
  .latest {
    margin-top: 24px;
    columns: 2 280px;
    padding-left: 1.2em;
  }
  .faq {
    margin-top: 96px;
    display: grid;
    gap: 12px;
  }
  details summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
  }
  details p {
    margin: 12px 0 0;
  }
  .final {
    margin-top: 96px;
  }
  .final-card {
    text-align: center;
    padding: 44px 24px;
  }
  .final-card h2 {
    margin-top: 0;
  }
  .final-card :global(.stores) {
    justify-content: center;
    margin-top: 20px;
  }
</style>
