---
import { getImage, Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SITE, HUBS, anyStoreLive } from '../config';
import heroWide from '../assets/hero/a.jpg';
import heroTall from '../assets/hero/b.jpg';
import shotPlan from '../assets/screens/01-plan.png';
import shotTrack from '../assets/screens/02-track.png';
import shotCatch from '../assets/screens/03-catch.png';
import shotShop from '../assets/screens/04-shop.png';
import shotSee from '../assets/screens/05-see.png';
import { guideUrl } from '../lib/guides';

const wideAvif = await getImage({ src: heroWide, format: 'avif', width: 1376, quality: 60 });
const wideWebp = await getImage({ src: heroWide, format: 'webp', width: 1376, quality: 72 });
const tallAvif = await getImage({ src: heroTall, format: 'avif', width: 768, quality: 60 });
const tallWebp = await getImage({ src: heroTall, format: 'webp', width: 768, quality: 72 });

const allGuides = await getCollection('guides');
// Newest guides with a hero image lead the home page as cards; the rest as links.
const byNewest = allGuides.filter((g) => !g.data.pillar).sort((a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.order - b.data.order);
const featured = byNewest.filter((g) => g.data.image).slice(0, 6);
const guides = byNewest.filter((g) => !featured.includes(g)).slice(0, 8);

const features = [
  {
    shot: shotPlan,
    eyebrow: 'Plan',
    title: 'Snap a photo, get the full job',
    body: 'Photograph the job and Jib drafts the steps, the materials list and a cost range — so you know what you are signing up for before the first trip to the hardware store.',
  },
  {
    shot: shotCatch,
    eyebrow: 'Catch',
    title: 'DIY safe, or tradie required?',
    body: 'Every job gets a verdict in its corner: green for DIY safe, red when a step legally needs a licensed electrician, plumber or gasfitter where you live — so you do the bits you can and book a pro for the bits you can’t.',
  },
  {
    shot: shotShop,
    eyebrow: 'Shop',
    title: 'Only buy the tools you don’t own',
    body: 'Jib knows what’s in your Toolbox, so every job shows which tools you already have and which you’d need to buy. Missing tools and materials roll into one shopping list, grouped by store.',
  },
  {
    shot: shotTrack,
    eyebrow: 'Track',
    title: 'Every job, every room, one glance',
    body: 'Keep jobs organised by room, set reminders for the recurring ones, and see what’s done and what’s next.',
  },
  {
    shot: shotSee,
    eyebrow: 'See',
    title: 'Before and after, room by room',
    body: 'Photos land in a gallery and a timeline of your home — the record of what you’ve changed, handy when you sell.',
  },
];

const spots = [
  {
    href: '/guides/features/photo-to-job-plan/',
    img: '/images/blog/photo-to-plan.jpg',
    alt: 'A parent holding a toddler snaps a photo of a crooked cupboard door',
    eyebrow: 'Photo → full job plan',
    title: 'Toddler on your hip? Just snap it.',
    body: 'See something that needs fixing, take a photo, get on with your day. Jib’s AI names the job, files it under the right room and writes the steps, materials, tools, time and cost.',
    more: 'How snap-it-now works',
  },
  {
    href: '/guides/features/quick-home-jobs-by-time/',
    img: '/images/blog/quick-jobs.jpg',
    alt: 'A dad tightening a cupboard hinge while a child plays nearby',
    eyebrow: 'Pick a job that fits',
    title: 'Got 30 minutes? There’s a job for that.',
    body: 'Every job shows how long it takes. When a spare half hour turns up, scroll your list and pick something you can actually finish before the kids wake up.',
    more: 'Quick jobs by time',
  },
  {
    href: '/guides/features/home-to-do-list-no-time/',
    img: '/images/blog/home-todo-list.jpg',
    alt: 'A parent scrolling a list of home jobs on the couch with a sleeping child',
    eyebrow: 'Your home to-do list',
    title: 'A to-do list you never have to write.',
    body: 'Every photo becomes a planned job, grouped by room, with one shopping list for the lot. The list builds itself while you live your life.',
    more: 'The snap-it method',
  },
  {
    href: '/guides/features/ai-step-by-step-directions/',
    img: '/images/blog/bathroom-mould.jpg',
    alt: 'Cleaning mould from a shower corner',
    eyebrow: 'AI directions',
    title: 'Step-by-step instructions, no research.',
    body: 'Skip the YouTube rabbit hole. Jib writes the steps for your exact job from the photo: prep, order, drying times, safety, and which step needs a pro.',
    more: 'How AI directions work',
  },
  {
    href: '/guides/features/ai-shopping-list/',
    img: '/images/blog/materials.jpg',
    alt: 'A parent pushing a hardware store trolley with a toddler in the seat',
    eyebrow: 'AI shopping list',
    title: 'Come home from the hardware store with everything.',
    body: 'Every job’s materials land on one list that writes itself, grouped by store, with what each item is for. Open it in the aisle and tick as you go.',
    more: 'How the shopping list works',
  },
  {
    href: '/guides/features/garage-tool-inventory/',
    img: '/images/blog/toolbox-garage-scan.jpg',
    alt: 'Holding a phone up to a garage pegboard while the app outlines each tool it recognises',
    eyebrow: 'AI Toolbox',
    title: 'One photo of your shed. Every tool, remembered.',
    body: 'Scan your garage, shed or a hardware receipt and Jib lists every tool it sees. Every job after that knows what you own, and asks before adding the tools you’re missing to your shopping list.',
    more: 'How the AI Toolbox works',
  },
  {
    href: '/guides/features/diy-or-tradie-verdict/',
    img: '/images/blog/diy-or-tradie-flag.jpg',
    alt: 'A phone with a red corner flag held up in front of an opened power point',
    eyebrow: 'DIY safe · Tradie required',
    title: 'A legal verdict in the corner of every job.',
    body: 'Green means it’s yours to do. Red means a step legally needs a licensed electrician, plumber or gasfitter where you live, and Jib tells you exactly which one.',
    more: 'How the verdict works',
  },
  {
    href: '/guides/features/home-maintenance-reminders/',
    img: '/images/blog/home-maintenance-checklist.jpg',
    alt: 'A phone showing a maintenance checklist in front of an Australian home in spring',
    eyebrow: 'Reminders',
    title: 'The jobs that come back, on autopilot.',
    body: 'Smoke alarms monthly, gutters every autumn and spring, termites yearly. Set a job to repeat and Jib reminds you when it’s due. Build your schedule with our free planner.',
    more: 'How reminders work',
  },
  {
    href: '/guides/features/before-and-after-photos/',
    img: '/images/blog/before-after-sale.jpg',
    alt: 'A phone showing before and after photos of a renovated living room',
    eyebrow: 'Before & after',
    title: 'Every room’s glow-up, on record.',
    body: 'Before and after photos land in a gallery and a timeline for each room, the record of what you’ve done, and gold when it’s time to sell.',
    more: 'Why before & afters pay off',
  },
  {
    href: '/web/?demo',
    img: '/images/blog/web-app.jpg',
    alt: 'A laptop showing Jib on the web next to a phone on a kitchen bench',
    eyebrow: 'Jib on the web',
    title: 'Your jobs, on the big screen too.',
    body: 'Sign in on your computer to manage jobs, tools, the shopping list and your Toolbox, with the same account as the app. Try the demo, no sign-up needed.',
    more: 'Try the web demo',
  },
];

// Every feature, sold as a benefit — the first thing visitors see under the hero.
const featureTiles = [
  { icon: 'snap', star: true, href: '/guides/features/photo-to-job-plan/', title: 'Snap it, AI plans it', body: 'One photo becomes a named job with steps, materials, tools, time and cost. No typing.' },
  { icon: 'checker', star: true, href: '/guides/features/diy-or-tradie-verdict/', title: 'DIY safe or tradie required', body: 'A legal verdict on every job, for your state, and the exact step that needs a licence.' },
  { icon: 'steps', href: '/guides/features/ai-step-by-step-directions/', title: 'Step-by-step directions', body: 'The steps for your exact job, with drying times and safety. No YouTube rabbit hole.' },
  { icon: 'cart', href: '/guides/features/ai-shopping-list/', title: 'A shopping list that writes itself', body: 'Every job’s materials on one list, by store, with what each item is for.' },
  { icon: 'toolbox', href: '/guides/features/garage-tool-inventory/', title: 'AI Toolbox', body: 'Scan your shed once. Jobs know what you own, so you only buy what’s missing.' },
  { icon: 'clock', href: '/guides/features/quick-home-jobs-by-time/', title: 'Jobs that fit your time', body: 'Every job shows how long it takes. Got 30 minutes? Pick one you’ll finish.' },
  { icon: 'cost', href: '/guides/features/home-repair-cost-estimates/', title: 'Know the cost first', body: 'A realistic cost range before you start, including when a tradie adds a call-out.' },
  { icon: 'bell', href: '/guides/features/home-maintenance-reminders/', title: 'Reminders on autopilot', body: 'Smoke alarms, gutters, filters, termites: set them to repeat and get reminded.' },
  { icon: 'chat', href: '/guides/features/ai-step-by-step-directions/', title: 'Ask AI about any job', body: 'Stuck on a step? Ask, and the answer knows your job, photo and plan.' },
  { icon: 'rooms', href: '/guides/features/home-to-do-list-no-time/', title: 'Every room, organised', body: 'Jobs sorted by space, with a to-do list you never have to write.' },
  { icon: 'beforeafter', href: '/guides/features/before-and-after-photos/', title: 'Before & after, on record', body: 'A gallery and timeline for every room. Gold when you sell or claim insurance.' },
  { icon: 'homes', href: '/guides/features/', title: 'Every property you look after', body: 'Your home, a rental, the beach house or Mum’s place, each with its own jobs.' },
  { icon: 'climate', href: '/guides/features/', title: 'Built for your home and climate', body: 'Plans and rules for where your house is, not generic advice from overseas.' },
  { icon: 'web', href: '/web/?demo', title: 'On your phone and computer', body: 'Snap on your phone, plan on the big screen. Everything syncs.' },
];

const faqs = [
  {
    q: 'Is Jib free?',
    a: 'Jib is free to download, and you can track jobs, rooms, reminders and photos for free. The AI features — turning a photo into a full plan, materials list and cost estimate, and asking follow-up questions — are part of Jib’s paid plans, which come with a 7-day free trial.',
  },
  {
    q: 'Does Jib tell me if a job is legal to DIY?',
    a: 'Yes. On Jib’s paid plans, every job gets a corner flag: DIY safe (green) or tradie required (red), based on the licensing rules where your house is, with the exact step that needs a licence. It’s general guidance, not legal advice: always confirm with your state regulator or council. Our free DIY legality checker shows the rules for common jobs by state, with links to the regulator.',
  },
  {
    q: 'What is the AI Toolbox?',
    a: 'Photograph your garage, shed or a hardware receipt and Jib lists every tool it can see. After that, every job you plan checks your Toolbox, ticks off the tools you already own, and asks before adding any you’re missing to your shopping list. The AI Toolbox is part of Jib’s paid plans.',
  },
  {
    q: 'Is Jib only for Australia?',
    a: 'No — Jib works anywhere and supports AUD, USD, GBP, EUR, NZD and CAD. Our guides start with Australian rules because they vary so much between states, with UK and New Zealand guides alongside.',
  },
  {
    q: 'What phones does Jib run on?',
    a: 'iPhone (App Store) and Android (Google Play).',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Jib: Home Improvement Planner',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    description: SITE.description,
    url: SITE.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Jib — Snap a photo, get the full DIY job plan"
  description="Photograph any home job and Jib drafts the steps, materials list and cost — and flags the parts that legally need a licensed tradie in your state."
  jsonLd={jsonLd}
>
  <section class="hero">
    <picture class="hero-img">
      <source media="(max-width: 719px)" srcset={tallAvif.src} type="image/avif" />
      <source media="(max-width: 719px)" srcset={tallWebp.src} type="image/webp" />
      <source srcset={wideAvif.src} type="image/avif" />
      <img src={wideWebp.src} alt="Holding a phone up in front of a Queenslander house at golden hour, with a paintbrush and spirit level on the deck" width="1376" height="768" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">The home jobs app for people with no time</p>
      <h1>See a job. Snap it.<br /><span>Jib does the rest.</span></h1>
      <p class="lede">
        Photograph anything around the house that needs doing. Jib’s AI writes the plan, the shopping list and the cost, and tells you if it’s DIY-legal or needs a tradie. Then pick a job whenever you’ve got a spare hour.
      </p>
      <div class="hero-ctas">
        {
          anyStoreLive ? (
            <StoreButtons campaign="home" size="lg" />
          ) : (
            <>
              <a class="btn btn-primary" href="/web/?demo">Try Jib free on the web</a>
              <a class="btn btn-ghost" href="/app/" data-get-app>Get it on your phone</a>
            </>
          )
        }
      </div>
      <ul class="trust">
        <li>✓ Free to download</li>
        <li>✓ 7-day free trial of every AI feature</li>
        <li>✓ Built for Australian homes and rules</li>
      </ul>
    </div>
  </section>

  <section class="wrap everything" aria-labelledby="everything-title">
    <div class="everything-head">
      <p class="eyebrow">Everything your home needs, in one app</p>
      <h2 id="everything-title">From “that needs fixing” to done, without the research, the lists or the guesswork.</h2>
    </div>
    <div class="feat-grid">
      {
        featureTiles.map((f) => (
          <a class={`feat ${f.star ? 'star' : ''}`} href={f.href}>
            <ToolIcon name={f.icon} size={52} />
            <span class="feat-copy">
              <strong>{f.title}</strong>
              <span>{f.body}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap how" aria-labelledby="how-title">
    <h2 id="how-title" class="sr-only">How Jib works</h2>
    <ol class="how-steps">
      <li><span class="how-n">1</span><strong>Snap it</strong><span>See something that needs doing? Take a photo and get on with your day.</span></li>
      <li><span class="how-n">2</span><strong>Jib plans it</strong><span>AI writes the job, steps, materials, tools, cost and a DIY-or-tradie verdict.</span></li>
      <li><span class="how-n">3</span><strong>Do it when you can</strong><span>Got a spare hour? Pick a job that fits, with everything on one shopping list.</span></li>
    </ol>
    <div class="how-cta">
      {
        anyStoreLive ? (
          <StoreButtons campaign="home" size="lg" />
        ) : (
          <>
            <a class="btn btn-primary" href="/web/?demo">Try the free web demo</a>
            <a class="btn btn-ghost" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Tell me when Jib launches')}&body=${encodeURIComponent('Please email me when Jib is on the App Store / Google Play. My phone is: iPhone / Android')}`}>Tell me when it’s on the App Store</a>
          </>
        )
      }
    </div>
  </section>

  <a class="mobile-cta" href={anyStoreLive ? '/app/?c=home' : '/web/?demo'} data-get-app>
    <span>{anyStoreLive ? 'Get Jib free' : 'Try Jib free'}</span><small>{anyStoreLive ? 'iPhone & Android' : 'on the web, no sign-up'}</small>
  </a>

  <section class="wrap spotlight-head">
    <p class="eyebrow">Built for people with no time</p>
    <h2 class="section-title">Snap it now. Plan it later. Do it when you’ve got a spare hour.</h2>
    <p class="muted">Jib was made by a parent who kept seeing jobs around the house and never had time to write them down. Here’s how it fits into a busy life.</p>
  </section>
  <section class="wrap spotlight" aria-label="How Jib works">
    {
      spots.map((sp) => (
        <a class="card spot" href={sp.href}>
          <img src={sp.img} alt={sp.alt} width="1376" height="768" loading="lazy" decoding="async" />
          <div class="spot-copy">
            <p class="eyebrow">{sp.eyebrow}</p>
            <h2>{sp.title}</h2>
            <p>{sp.body}</p>
            <span class="more">{sp.more} →</span>
          </div>
        </a>
      ))
    }
  </section>

  <section class="wrap features" aria-label="What Jib does">
    {
      features.map((f, i) => (
        <article class={`feature ${i % 2 ? 'flip' : ''}`}>
          <div class="feature-copy">
            <p class="eyebrow">{f.eyebrow}</p>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </div>
          <Image src={f.shot} alt={`Jib app screen: ${f.title}`} widths={[320, 480]} sizes="(max-width: 719px) 70vw, 320px" loading="lazy" class="shot" />
        </article>
      ))
    }
  </section>

  <section class="wrap tool-promo">
    <div class="card promo">
      <div>
        <p class="eyebrow">Free tool</p>
        <h2>DIY or tradie? Check the rules for your state.</h2>
        <p>Pick your state and the job. We’ll tell you whether you can legally do it yourself, whether you need a licence or a compliance certificate — and link the regulator that says so.</p>
      </div>
      <a class="btn btn-primary" href="/tools/diy-legality-checker/">Open the DIY checker</a>
    </div>
  </section>

  <section class="wrap">
    <p class="eyebrow">Guides</p>
    <h2 class="section-title">Straight answers for real jobs</h2>
    <div class="grid grid-3 hubs">
      {
        Object.entries(HUBS).map(([key, hub]) => (
          <a class="card hub" href={`/guides/${key}/`}>
            <h3>{hub.title}</h3>
            <p class="muted">{hub.blurb}</p>
            <span class="more">Browse guides →</span>
          </a>
        ))
      }
    </div>
    {
      featured.length > 0 && (
        <div class="grid grid-3 featured">
          {featured.map((g) => (
            <a class="card fcard" href={guideUrl(g)}>
              <img src={g.data.image} alt="" width="1376" height="768" loading="lazy" decoding="async" />
              <strong>{g.data.title}</strong>
            </a>
          ))}
        </div>
      )
    }
    {
      guides.length > 0 && (
        <ul class="latest">
          {guides.map((g) => (
            <li>
              <a href={guideUrl(g)}>{g.data.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wrap faq">
    <h2 class="section-title">Questions</h2>
    {
      faqs.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </section>

  <section class="wrap final">
    <div class="card final-card">
      <h2>Your next job, planned properly.</h2>
      <p class="muted">Snap it, plan it, buy what you need, and know when to call a pro.</p>
      <StoreButtons campaign="home" size="lg" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(70vh, 620px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-img,
  .hero-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 24, 36, 0.1) 0%, rgba(14, 24, 36, 0.35) 40%, rgba(14, 24, 36, 0.95) 100%);
  }
  @media (min-width: 720px) {
    .hero {
      align-items: center;
    }
    .hero-shade {
      background: linear-gradient(90deg, rgba(14, 24, 36, 0.95) 0%, rgba(14, 24, 36, 0.75) 40%, rgba(14, 24, 36, 0.1) 75%),
        linear-gradient(180deg, transparent 70%, var(--bg) 100%);
    }
  }
  .hero-copy {
    position: relative;
    padding-top: 84px;
    padding-bottom: 110px;
    width: 100%;
  }
  .hero h1 {
    max-width: 20ch;
    font-size: clamp(2.2rem, 5.2vw, 3.5rem);
  }
  .hero h1 span {
    color: #9cc2ff;
  }
  .lede {
    font-size: 1.15rem;
    color: #e3eaf2;
    max-width: 46ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 0;
    margin: 18px 0 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #d7e6fb;
  }

  /* Everything Jib does: overlaps the hero so it's on the first screen */
  .everything {
    position: relative;
    z-index: 2;
    margin-top: -90px;
  }
  .everything-head {
    background: linear-gradient(180deg, rgba(14, 24, 36, 0.2), var(--bg) 70%);
    padding-top: 8px;
  }
  .everything-head h2 {
    margin: 4px 0 18px;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    max-width: 34ch;
  }
  .feat-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) {
    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .feat-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1180px) {
    .feat-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .feat {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .feat:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    color: var(--text);
  }
  .feat.star {
    background: linear-gradient(135deg, rgba(39, 112, 218, 0.28), var(--surface) 70%);
    border-color: rgba(79, 143, 240, 0.45);
  }
  @media (min-width: 1180px) {
    .feat.star {
      grid-column: span 2;
      padding: 20px 22px;
    }
    .feat.star .feat-copy strong {
      font-size: 1.25rem;
    }
    .feat.star .feat-copy span {
      font-size: 0.98rem;
    }
  }
  .feat-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .feat-copy strong {
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.25;
  }
  .feat-copy span {
    color: var(--dim);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* How it works */
  .how {
    margin-top: 40px;
    background: linear-gradient(135deg, var(--accent-deep), #173a6b);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    padding: 26px;
  }
  .how-steps {
    list-style: none;
    margin: 0;
