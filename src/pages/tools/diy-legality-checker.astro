---
import Base from '../../layouts/Base.astro';
import AppCta from '../../components/AppCta.astro';
import { SITE } from '../../config';
import data from '../../data/legality.json';
import { formatDate } from '../../lib/guides';

type Verdict = { v: 'diy' | 'licensed' | 'depends'; note: string; source?: string };
const states = data.states as { code: string; name: string; regulator: { name: string; url: string } }[];
const jobs = data.jobs as { id: string; name: string; trade: string; guide?: string }[];
const verdicts = data.verdicts as Record<string, Record<string, Verdict>>;
const ready = jobs.length > 0;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'DIY legality checker (Australia)',
    url: `${SITE.url}/tools/diy-legality-checker/`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
    publisher: { '@id': `${SITE.url}/#org` },
  },
];
---

<Base
  title="DIY or tradie? Free DIY legality checker for Australia"
  description="Pick your state and the job to see if you can legally DIY it or need a licensed electrician, plumber or gasfitter — with a link to the regulator that says so."
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <p class="eyebrow">Free tool</p>
    <h1>DIY or tradie? Check the rules for your state</h1>
    <p class="lede muted">Pick your state and the job. You’ll see whether it’s legal to do yourself, and the official source that says so.</p>

    {
      ready ? (
        <div class="checker card" id="checker">
          <div class="fields">
            <label>
              <span>Your state or territory</span>
              <select id="state">
                {states.map((s) => (
                  <option value={s.code}>{s.name}</option>
                ))}
              </select>
            </label>
            <label>
              <span>The job</span>
              <select id="job">
                {jobs.map((j) => (
                  <option value={j.id}>{j.name}</option>
                ))}
              </select>
            </label>
          </div>
          <div class="result" id="result" aria-live="polite" />
        </div>
      ) : (
        <div class="card">
          <p>We’re finishing checking every rule against each state’s regulator before this tool goes live. In the meantime, read <a href="/guides/diy-legal/">what you can legally DIY</a>.</p>
        </div>
      )
    }

    {
      ready && (
        <section class="all">
          <h2 id="all-title">Every job in <span id="state-name" /></h2>
          <div class="prose">
            <table>
              <thead>
                <tr>
                  <th>Job</th>
                  <th>Can I DIY it?</th>
                </tr>
              </thead>
              <tbody id="table" />
            </table>
          </div>
        </section>
      )
    }

    <AppCta text="Got a job that’s not on the list? Photograph it in Jib and it flags every step that needs a licensed tradie." campaign="tools" />

    <p class="muted fine">
      Rules last checked {formatDate(new Date(data.lastChecked))}. This is general information, not legal advice. Rules can change and some councils, strata schemes and insurers add their own — check with your regulator before starting, and if in doubt, use a licensed tradie.
    </p>
  </div>

  <script type="application/json" id="legality-data" set:html={JSON.stringify({ states, jobs, verdicts })} />
</Base>

<script>
  type Verdict = { v: 'diy' | 'licensed' | 'depends'; note: string; source?: string };
  const el = document.getElementById('legality-data');
  const stateSel = document.getElementById('state') as HTMLSelectElement | null;
  const jobSel = document.getElementById('job') as HTMLSelectElement | null;
  const result = document.getElementById('result');
  const table = document.getElementById('table');
  const stateName = document.getElementById('state-name');

  if (el && stateSel && jobSel && result && table && stateName) {
    const data = JSON.parse(el.textContent || '{}') as {
      states: { code: string; name: string; regulator: { name: string; url: string } }[];
      jobs: { id: string; name: string; guide?: string }[];
      verdicts: Record<string, Record<string, Verdict>>;
    };
    const labels = { diy: 'DIY OK', licensed: 'Licensed tradie', depends: 'It depends' } as const;
    const cls = { diy: 'ok', licensed: 'no', depends: 'maybe' } as const;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const lookup = (job: string, state: string): Verdict | undefined => data.verdicts[job]?.[state] ?? data.verdicts[job]?.default;

    // Remember the reader's state so the table stays relevant on return
    // visits; storage can be blocked, so failure just means no memory.
    try {
      const saved = localStorage.getItem('jib-state');
      if (saved && data.states.some((s) => s.code === saved)) stateSel.value = saved;
    } catch {}
    const params = new URLSearchParams(location.search);
    if (params.get('state')) stateSel.value = params.get('state')!.toUpperCase();
    if (params.get('job')) jobSel.value = params.get('job')!;

    function render() {
      const st = data.states.find((s) => s.code === stateSel!.value)!;
      const job = data.jobs.find((j) => j.id === jobSel!.value)!;
      const v = lookup(job.id, st.code);
      try {
        localStorage.setItem('jib-state', st.code);
      } catch {}
      if (v) {
        const source = v.source ? `<a href="${esc(v.source)}" rel="noopener">Official source</a>` : `<a href="${esc(st.regulator.url)}" rel="noopener">${esc(st.regulator.name)}</a>`;
        const guide = job.guide ? ` · <a href="/guides/${esc(job.guide)}/">Read the full guide</a>` : '';
        result!.innerHTML = `<p class="verdict"><span class="v ${cls[v.v]}">${labels[v.v]}</span> <strong>${esc(job.name)}</strong> in ${esc(st.name)}</p><p>${esc(v.note)}</p><p class="src">${source}${guide}</p>`;
      }
      stateName!.textContent = st.name;
      table!.innerHTML = data.jobs
        .map((j) => {
          const jv = lookup(j.id, st.code);
          return jv ? `<tr><td>${esc(j.name)}</td><td><span class="v ${cls[jv.v]}">${labels[jv.v]}</span></td></tr>` : '';
        })
        .join('');
    }
    stateSel.addEventListener('change', render);
    jobSel.addEventListener('change', render);
    render();
  }
</script>

<style>
  .page {
    padding-top: 40px;
  }
  .lede {
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .checker {
    margin-top: 24px;
    max-width: 820px;
  }
  .fields {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .fields {
      grid-template-columns: 1fr 1.4fr;
    }
  }
  label span {
    display: block;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
    font-size: 0.95rem;
  }
  select {
    width: 100%;
    min-height: 48px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--ink);
    font: inherit;
  }
  .result {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .result :global(.verdict) {
    font-size: 1.1rem;
    color: var(--ink);
  }
  .result :global(.src) {
    font-size: 0.95rem;
    margin-bottom: 0;
  }
  .all {
    max-width: 820px;
  }
  .fine {
    font-size: 0.88rem;
    max-width: 70ch;
  }
</style>
